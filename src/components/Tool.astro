---
import type { Mode } from '../site';
interface Props {
  mode: Mode;
  preset?: { from?: number; to?: number; out?: string };
}
const { mode, preset = {} } = Astro.props;
const tabs: { id: Mode; label: string }[] = [
  { id: 'shift', label: 'Shift timing' },
  { id: 'fps', label: 'Change frame rate' },
  { id: 'sync', label: 'Sync two points' },
  { id: 'clean', label: 'Clean up' },
  { id: 'convert', label: 'Convert format' },
];
const fps = [
  { v: String(24000 / 1001), l: '23.976' },
  { v: '24', l: '24' },
  { v: '25', l: '25 (PAL)' },
  { v: String(30000 / 1001), l: '29.97' },
  { v: '30', l: '30' },
];
const from = String(preset.from ?? 25);
const to = String(preset.to ?? 24000 / 1001);
---

<section class="tool" data-mode={mode} data-out={preset.out ?? ''}>
  <label class="drop" id="drop">
    <input type="file" id="file" class="visually-hidden" accept=".srt,.vtt,.ass,.ssa,.sub,.sbv,.smi,.sami,.lrc,.txt" />
    <span class="drop-main">Drop a subtitle file here</span>
    <span class="drop-sub">SRT, VTT, ASS, SSA, SUB or SBV. The file stays on your device.</span>
    <span class="drop-btn" aria-hidden="true">Choose a file</span>
  </label>

  <div class="loaded" id="loaded" hidden>
    <div class="fileinfo">
      <strong id="fname"></strong>
      <span id="fmeta"></span>
      <label class="enc">Encoding
        <select id="enc"><option value="">Auto</option></select>
      </label>
      <button type="button" class="link" id="reset">Use another file</button>
    </div>

    <div class="tabs" role="tablist">
      {tabs.map((t) => (
        <button type="button" role="tab" data-tab={t.id} aria-selected={t.id === mode ? 'true' : 'false'}>{t.label}</button>
      ))}
    </div>

    <div class="panel" data-panel="shift">
      <label>Offset
        <input id="offset" value="0" inputmode="decimal" placeholder="e.g. 2.5 or -00:00:01,200" />
      </label>
      <div class="nudges">
        <button type="button" data-nudge="-1000">−1 s</button>
        <button type="button" data-nudge="-100">−0.1 s</button>
        <button type="button" data-nudge="100">+0.1 s</button>
        <button type="button" data-nudge="1000">+1 s</button>
      </div>
      <p class="hint">Positive shows subtitles later, negative sooner. Seconds, or a time like 00:01:05,300.</p>
    </div>

    <div class="panel" data-panel="fps">
      <label>Subtitles were made for
        <select id="fpsFrom">{fps.map((f) => <option value={f.v} selected={f.v === from}>{f.l} fps</option>)}</select>
      </label>
      <button type="button" class="swap" id="swap" aria-label="Swap frame rates">⇄</button>
      <label>My video is
        <select id="fpsTo">{fps.map((f) => <option value={f.v} selected={f.v === to}>{f.l} fps</option>)}</select>
      </label>
      <p class="hint" id="fpsHint"></p>
    </div>

    <div class="panel" data-panel="sync">
      <div class="syncrow">
        <label>Early line <select id="l1"></select></label>
        <label>should appear at <input id="t1" placeholder="00:00:00,000" /></label>
      </div>
      <div class="syncrow">
        <label>Late line <select id="l2"></select></label>
        <label>should appear at <input id="t2" placeholder="00:00:00,000" /></label>
      </div>
      <p class="hint">Find each line in your video and type when it is actually spoken.</p>
    </div>

    <div class="panel" data-panel="clean">
      <label class="check"><input type="checkbox" id="hi" checked /> Remove hearing-impaired text ([MUSIC], (laughs), JOHN:)</label>
      <label class="check"><input type="checkbox" id="tags" /> Remove formatting tags (&lt;i&gt;, &lt;font&gt;, {'{\\an8}'})</label>
      <label class="check"><input type="checkbox" id="overlaps" checked /> Fix overlapping lines</label>
      <label class="check"><input type="checkbox" id="mindur" checked /> Keep each line on screen at least 0.7 s</label>
      <p class="hint" id="cleanReport"></p>
    </div>

    <div class="panel" data-panel="convert">
      <p class="hint">Pick the output format below. Timing and text are kept.</p>
    </div>

    <div class="outrow">
      <label>Save as
        <select id="outFmt">
          <option value="srt">SRT</option>
          <option value="vtt">VTT</option>
          <option value="ass">ASS</option>
          <option value="ssa">SSA</option>
          <option value="sbv">SBV</option>
        </select>
      </label>
      <button type="button" class="primary" id="download">Download fixed file</button>
    </div>

    <p class="error" id="opError" hidden></p>

    <div class="preview">
      <table>
        <thead><tr><th>#</th><th>Before</th><th>After</th><th>Text</th></tr></thead>
        <tbody id="rows"></tbody>
      </table>
    </div>
  </div>
  <p class="error" id="loadError" hidden></p>
</section>

<script>
  import {
    decode, parse, build, retime, retimeAssRaw, shiftFn, fpsFn, twoPointFn, fixCommon,
    fmtTime, parseTime, ENCODINGS, FORMAT_LABEL, type Doc, type OutFormat, type Caption, type TimeFn,
  } from '../lib/subs';

  const root = document.querySelector<HTMLElement>('.tool')!;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const fileInput = $<HTMLInputElement>('file');
  const drop = $('drop');
  const encSel = $<HTMLSelectElement>('enc');
  const outFmt = $<HTMLSelectElement>('outFmt');
  for (const e of ENCODINGS) encSel.add(new Option(e, e));

  let mode = root.dataset.mode as string;
  let buf: ArrayBuffer | null = null;
  let fileName = 'subtitles';
  let doc: Doc | null = null;

  function setTab(id: string) {
    mode = id;
    root.querySelectorAll<HTMLElement>('[data-tab]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === id)));
    root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== id));
    render();
  }
  root.querySelectorAll<HTMLElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => setTab(b.dataset.tab!)));
  setTab(mode);

  async function load(forcedEnc?: string) {
    if (!buf) return;
    const err = $('loadError');
    err.hidden = true;
    try {
      const { text, encoding } = await decode(buf, forcedEnc);
      const fpsFrom = parseFloat($<HTMLSelectElement>('fpsFrom').value) || 23.976;
      doc = parse(text, fpsFrom);
      if (!forcedEnc) encSel.value = ENCODINGS.find((e) => e.toLowerCase() === encoding.toLowerCase()) ?? '';
      $('fname').textContent = fileName;
      const c = doc.captions;
      $('fmeta').textContent = `${FORMAT_LABEL[doc.format] ?? doc.format} · ${n(c.length, 'line')} · ${fmtTime(c[0].start)} → ${fmtTime(c[c.length - 1].end)} · read as ${encoding}`;
      const preset = root.dataset.out;
      outFmt.value = preset || (['srt', 'vtt', 'ass', 'ssa', 'sbv'].includes(doc.format) ? doc.format : 'srt');
      fillSyncLines();
      drop.hidden = true;
      $('loaded').hidden = false;
      render();
    } catch (e: any) {
      err.textContent = e?.message ?? String(e);
      err.hidden = false;
    }
  }

  function fillSyncLines() {
    if (!doc) return;
    const l1 = $<HTMLSelectElement>('l1');
    const l2 = $<HTMLSelectElement>('l2');
    l1.innerHTML = l2.innerHTML = '';
    doc.captions.forEach((c, i) => {
      const label = `${i + 1}. ${fmtTime(c.start)}  ${c.text.replace(/\n/g, ' ').slice(0, 40)}`;
      l1.add(new Option(label, String(i)));
      l2.add(new Option(label, String(i)));
    });
    l1.value = '0';
    l2.value = String(doc.captions.length - 1);
    $<HTMLInputElement>('t1').value = fmtTime(doc.captions[0].start);
    $<HTMLInputElement>('t2').value = fmtTime(doc.captions[doc.captions.length - 1].start);
  }

  function timeFn(): TimeFn | null {
    if (!doc) return null;
    if (mode === 'shift') {
      const raw = $<HTMLInputElement>('offset').value.trim();
      const ms = /^-?\d+(\.\d+)?$/.test(raw) ? Math.round(parseFloat(raw) * 1000) : parseTime(raw);
      if (isNaN(ms)) throw new Error('Enter the offset in seconds (like 2.5 or -1) or as a time (00:00:02,500).');
      return shiftFn(ms);
    }
    if (mode === 'fps') {
      const a = parseFloat($<HTMLSelectElement>('fpsFrom').value);
      const b = parseFloat($<HTMLSelectElement>('fpsTo').value);
      const pct = ((a / b - 1) * 100).toFixed(2);
      $('fpsHint').textContent = a === b ? 'Same frame rate, nothing will change.' : `Every time is multiplied by ${(a / b).toFixed(5)} (${+pct > 0 ? '+' : ''}${pct}%).`;
      return fpsFn(a, b);
    }
    if (mode === 'sync') {
      const i1 = +$<HTMLSelectElement>('l1').value;
      const i2 = +$<HTMLSelectElement>('l2').value;
      const t1 = parseTime($<HTMLInputElement>('t1').value);
      const t2 = parseTime($<HTMLInputElement>('t2').value);
      if (isNaN(t1) || isNaN(t2)) throw new Error('Type both target times, like 00:01:23,400.');
      if (i1 === i2) throw new Error('Pick two different lines.');
      return twoPointFn(doc.captions[i1].start, t1, doc.captions[i2].start, t2);
    }
    return null;
  }

  const n = (k: number, word: string) => `${k} ${word}${k === 1 ? '' : 's'}`;

  function compute(): { caps: Caption[]; text: string } {
    if (!doc) throw new Error('No file');
    const fmt = outFmt.value as OutFormat;
    const fn = timeFn();
    let caps = doc.captions;
    if (fn) caps = retime(caps, fn);
    if (mode === 'clean') {
      const { captions, report } = fixCommon(caps, {
        removeHearingImpaired: $<HTMLInputElement>('hi').checked,
        removeTags: $<HTMLInputElement>('tags').checked,
        fixOverlaps: $<HTMLInputElement>('overlaps').checked,
        minDurationMs: $<HTMLInputElement>('mindur').checked ? 700 : 0,
      });
      caps = captions;
      const parts = [];
      if (report.hiRemoved) parts.push(`hearing-impaired text removed from ${n(report.hiRemoved, 'line')}`);
      if (report.removedEmpty) parts.push(`${n(report.removedEmpty, 'empty line')} deleted`);
      if (report.fixedOverlaps) parts.push(`${n(report.fixedOverlaps, 'overlap')} fixed`);
      if (report.extended) parts.push(`${n(report.extended, 'short line')} lengthened`);
      if (report.sorted) parts.push('lines put back in time order');
      $('cleanReport').textContent = parts.length ? (parts.join(' · ') + '.').replace(/^./, (c) => c.toUpperCase()) : 'Nothing needed fixing with these options.';
    }
    // Same ASS/SSA format + timing-only change: rewrite in place so styling survives.
    const sameAss = (doc.format === 'ass' || doc.format === 'ssa') && fmt === doc.format && mode !== 'clean';
    const text = sameAss ? (fn ? retimeAssRaw(doc.raw, fn) : doc.raw) : build(caps, fmt);
    return { caps, text };
  }

  function esc(s: string) {
    return s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);
  }

  function render() {
    if (!doc) return;
    const err = $('opError');
    try {
      const { caps } = compute();
      err.hidden = true;
      const before = doc.captions;
      const show = mode === 'clean' ? caps.slice(0, 12) : before.slice(0, 6).concat(before.length > 12 ? before.slice(-6) : before.slice(6));
      const rows = show.map((c) => {
        const i = before.indexOf(c);
        const idx = mode === 'clean' ? caps.indexOf(c) : i;
        const after = mode === 'clean' ? c : caps[i];
        const orig = mode === 'clean' ? null : before[i];
        return `<tr><td>${idx + 1}</td><td>${orig ? fmtTime(orig.start) : ''}</td><td>${fmtTime(after.start)}</td><td>${esc(after.text).replace(/\n/g, '<br>')}</td></tr>`;
      });
      $('rows').innerHTML = rows.join('');
    } catch (e: any) {
      $('rows').innerHTML = '';
      err.textContent = e?.message ?? String(e);
      err.hidden = false;
    }
  }

  function download() {
    try {
      const { text } = compute();
      const fmt = outFmt.value;
      const base = fileName.replace(/\.[^.]+$/, '');
      const blob = new Blob([text],{ type: 'text/plain;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `${base}.fixed.${fmt}`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 2000);
      (window as any).plausible?.('download', { props: { mode, fmt } });
    } catch (e: any) {
      const err = $('opError');
      err.textContent = e?.message ?? String(e);
      err.hidden = false;
    }
  }

  async function takeFile(f: File) {
    fileName = f.name;
    if (f.size > 20 * 1024 * 1024) {
      const err = $('loadError');
      err.textContent = 'That file is over 20 MB, which is far bigger than a subtitle file should be.';
      err.hidden = false;
      return;
    }
    buf = await f.arrayBuffer();
    encSel.value = '';
    await load();
  }

  fileInput.addEventListener('change', () => fileInput.files?.[0] && takeFile(fileInput.files[0]));
  ['dragenter', 'dragover'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.add('over'); }));
  ['dragleave', 'drop'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.remove('over'); }));
  drop.addEventListener('drop', (e) => {
    const f = (e as DragEvent).dataTransfer?.files?.[0];
    if (f) takeFile(f);
  });
  // Allow dropping anywhere on the page.
  window.addEventListener('dragover', (e) => e.preventDefault());
  window.addEventListener('drop', (e) => {
    e.preventDefault();
    const f = e.dataTransfer?.files?.[0];
    if (f) takeFile(f);
  });

  encSel.addEventListener('change', () => load(encSel.value || undefined));
  $('reset').addEventListener('click', () => {
    doc = null; buf = null; fileInput.value = '';
    $('loaded').hidden = true; drop.hidden = false;
  });
  $('download').addEventListener('click', download);
  $('swap').addEventListener('click', () => {
    const a = $<HTMLSelectElement>('fpsFrom'), b = $<HTMLSelectElement>('fpsTo');
    [a.value, b.value] = [b.value, a.value];
    render();
  });
  root.querySelectorAll<HTMLElement>('[data-nudge]').forEach((b) =>
    b.addEventListener('click', () => {
      const o = $<HTMLInputElement>('offset');
      const cur = parseFloat(o.value) || 0;
      o.value = String(Math.round((cur + +b.dataset.nudge! / 1000) * 1000) / 1000);
      render();
    }),
  );
  root.addEventListener('input', (e) => {
    if ((e.target as HTMLElement).id !== 'enc') render();
  });
  root.addEventListener('change', (e) => {
    const id = (e.target as HTMLElement).id;
    if (id !== 'enc' && id !== 'file') render();
  });
</script>
