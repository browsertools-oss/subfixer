---
import type { Mode } from '../site';
import { LANG_ENCODINGS } from '../lib/subs';
import { DOC_FORMATS } from '../lib/export';
interface Props {
  mode: Mode;
  preset?: { from?: number; to?: number; out?: string; fromLine?: boolean };
  home?: boolean;
}
const { mode, preset = {}, home = false } = Astro.props;
const tabs: { id: Mode; label: string }[] = [
  { id: 'shift', label: 'Shift timing' },
  { id: 'fps', label: 'Change frame rate' },
  { id: 'sync', label: 'Sync two points' },
  { id: 'encoding', label: 'Fix characters' },
  { id: 'clean', label: 'Clean up' },
  { id: 'edit', label: 'Check and edit' },
  { id: 'convert', label: 'Convert format' },
];
// The symptom picker. Each answer opens one of the tabs above, in place.
const symptoms: { id: string; go: Mode; text: string }[] = [
  { id: 'early-late', go: 'shift', text: 'Early or late by the same amount the whole way through' },
  { id: 'one-scene', go: 'shift', text: 'Fine at first, then off from one scene onward' },
  { id: 'drift', go: 'fps', text: 'A little off at the start and worse as the video goes on' },
  { id: 'garbled', go: 'encoding', text: 'Letters show up as Ã©, Ð¿ or question marks' },
  { id: 'sdh', go: 'clean', text: 'Full of [MUSIC], (laughs) and speaker names' },
  { id: 'broken', go: 'edit', text: 'The player skips lines or will not open the file' },
  { id: 'format', go: 'convert', text: 'Wrong format for my player, website or editor' },
];
const picked = home ? '' : preset.fromLine ? 'one-scene' : symptoms.find((s) => s.go === mode)?.id ?? '';
const fps = [
  { v: String(24000 / 1001), l: '23.976' },
  { v: '24', l: '24' },
  { v: '25', l: '25 (PAL)' },
  { v: String(30000 / 1001), l: '29.97' },
  { v: '30', l: '30' },
];
const from = String(preset.from ?? 25);
const to = String(preset.to ?? 24000 / 1001);
---

<section class="tool" id="tool" data-mode={mode} data-out={preset.out ?? ''} data-symptom={picked}>
  <fieldset class="pick" id="pick">
    <legend>What is wrong with your subtitles?</legend>
    {symptoms.map((s) => (
      <label class="sym"><input type="radio" name="sym" value={s.id} data-go={s.go} checked={s.id === picked} /> {s.text}</label>
    ))}
  </fieldset>

  <label class="drop" id="drop">
    <input type="file" id="file" class="visually-hidden" multiple accept=".srt,.vtt,.ass,.ssa,.sub,.sbv,.smi,.sami,.lrc,.txt" />
    <span class="drop-main">Drop subtitle files here</span>
    <span class="drop-sub">SRT, VTT, ASS, SSA, SUB or SBV. One file or a whole season. Nothing leaves your device.</span>
    <span class="drop-btn" aria-hidden="true">Choose files</span>
  </label>

  <div class="loaded" id="loaded" hidden>
    <div class="fileinfo">
      <strong id="fname"></strong>
      <label class="filepick" id="filePickWrap" hidden><span id="fileCount"></span>
        <select id="filePick"></select>
      </label>
      <span id="fmeta"></span>
      <label class="enc">Encoding
        <select id="enc"><option value="">Auto</option></select>
      </label>
      <button type="button" class="link" id="reset">Use other files</button>
    </div>
    <p class="note" id="fileNote" hidden></p>

    <div class="tabs" role="tablist" aria-label="Fix">
      {tabs.map((t) => (
        <button type="button" role="tab" data-tab={t.id} aria-selected={t.id === mode ? 'true' : 'false'}>{t.label}</button>
      ))}
    </div>

    <div class="panel" data-panel="shift">
      <label>Offset
        <input id="offset" value="0" inputmode="decimal" placeholder="e.g. 2.5 or -00:00:01,200" />
      </label>
      <div class="nudges">
        <button type="button" data-nudge="-1000">−1 s</button>
        <button type="button" data-nudge="-100">−0.1 s</button>
        <button type="button" data-nudge="100">+0.1 s</button>
        <button type="button" data-nudge="1000">+1 s</button>
      </div>
      <label class="wide">Starting at line
        <select id="fromLine"></select>
      </label>
      <p class="hint">Positive shows subtitles later, negative sooner. Seconds, or a time like 00:01:05,300. To fix only the second half, start at the first wrong line.</p>
    </div>

    <div class="panel" data-panel="fps">
      <label>Subtitles were made for
        <select id="fpsFrom">{fps.map((f) => <option value={f.v} selected={f.v === from}>{f.l} fps</option>)}</select>
      </label>
      <button type="button" class="swap" id="swap" aria-label="Swap frame rates">⇄</button>
      <label>My video is
        <select id="fpsTo">{fps.map((f) => <option value={f.v} selected={f.v === to}>{f.l} fps</option>)}</select>
      </label>
      <p class="hint" id="fpsHint"></p>
    </div>

    <div class="panel" data-panel="sync">
      <div class="syncrow">
        <label>Early line <select id="l1"></select></label>
        <label>should appear at <input id="t1" placeholder="00:00:00,000" /></label>
      </div>
      <div class="syncrow">
        <label>Late line <select id="l2"></select></label>
        <label>should appear at <input id="t2" placeholder="00:00:00,000" /></label>
      </div>
      <p class="hint">Find each line in your video and type when it is actually spoken.</p>
    </div>

    <div class="panel stack" data-panel="encoding">
      <label>Language of the subtitles
        <select id="lang">
          <option value="">Not sure</option>
          {LANG_ENCODINGS.map((l, i) => <option value={String(i)}>{l.lang}</option>)}
        </select>
      </label>
      <fieldset class="cands" id="cands"><legend>Pick the version that reads correctly</legend><div id="candList"></div></fieldset>
      <p class="hint">Whichever you pick, the download is saved as UTF-8, which every current player reads.</p>
    </div>

    <div class="panel stack" data-panel="clean">
      <label class="check"><input type="checkbox" id="brackets" checked /> Sound descriptions in brackets: [door slams], (laughs)</label>
      <label class="check"><input type="checkbox" id="speakers" checked /> Speaker names at the start of a line: JOHN:</label>
      <label class="check"><input type="checkbox" id="music" checked /> Music and song lines: ♪ la la ♪</label>
      <label class="check"><input type="checkbox" id="tags" /> Formatting tags: &lt;i&gt;, &lt;font&gt;, {'{\\an8}'}</label>
      <label class="check"><input type="checkbox" id="dupes" checked /> The same line repeated back to back</label>
      <label class="check"><input type="checkbox" id="overlaps" checked /> Fix overlapping lines</label>
      <label class="check"><input type="checkbox" id="mindur" checked /> Keep each line on screen at least 0.7 s</label>
      <p class="hint" id="cleanReport"></p>
    </div>

    <div class="panel stack" data-panel="edit">
      <div id="checks" class="checks" aria-live="polite"></div>
      <label class="check"><input type="checkbox" id="onlyIssues" /> Only lines with problems</label>
      <div class="editor" id="editor"></div>
      <div class="edit-actions">
        <button type="button" class="link" id="moreRows" hidden>Show more lines</button>
        <button type="button" class="link" id="addEnd">Add a line at the end</button>
      </div>
    </div>

    <div class="panel" data-panel="convert">
      <p class="hint">Pick the output format below. Timing and text are kept. Italics and bold carry over where the format allows.</p>
    </div>

    <div class="outrow">
      <label>Save as
        <select id="outFmt">
          <optgroup label="Subtitles">
            <option value="srt">SRT</option>
            <option value="vtt">VTT</option>
            <option value="ass">ASS</option>
            <option value="ssa">SSA</option>
            <option value="sbv">SBV</option>
          </optgroup>
          <optgroup label="Text and documents">
            {DOC_FORMATS.map((d) => <option value={d.value}>{d.label}</option>)}
          </optgroup>
        </select>
      </label>
      <button type="button" class="primary" id="download">Download fixed file</button>
    </div>
    <p class="hint batchnote" id="batchNote" hidden></p>

    <p class="error" id="opError" hidden></p>

    <div class="preview" id="preview">
      <table>
        <thead><tr><th>#</th><th>Before</th><th>After</th><th>Text</th></tr></thead>
        <tbody id="rows"></tbody>
      </table>
    </div>
  </div>
  <p class="error" id="loadError" hidden></p>
</section>

<script>
  import {
    decode, parse, build, retime, retimeAssRaw, shiftFn, fpsFn, twoPointFn, fixCommon, validate, checkSrtRaw,
    encodingCandidates, garbleScore, fmtTime, parseTime, stripTags, ENCODINGS, LANG_ENCODINGS, REPAIR_UTF8, FORMAT_LABEL,
    type Doc, type OutFormat, type Caption, type TimeFn, type Candidate,
  } from '../lib/subs';
  import { DOC_FORMATS, isDocFormat, exportDoc, zipFiles, type DocFormat } from '../lib/export';

  type Entry = { name: string; buf: ArrayBuffer; doc: Doc | null; encoding: string; forced: string; edited: boolean; error: string; cands?: Candidate[] };

  const root = document.getElementById('tool')!;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const fileInput = $<HTMLInputElement>('file');
  const drop = $('drop');
  const encSel = $<HTMLSelectElement>('enc');
  const outFmt = $<HTMLSelectElement>('outFmt');
  for (const e of [...ENCODINGS, REPAIR_UTF8]) encSel.add(new Option(e, e));

  const BATCH_MODES = new Set(['shift', 'fps', 'encoding', 'clean', 'convert']);
  const SUB_FORMATS = ['srt', 'vtt', 'ass', 'ssa', 'sbv'];
  const EDITOR_PAGE = 200;

  let mode = root.dataset.mode as string;
  let files: Entry[] = [];
  let cur = 0;
  let editorLimit = EDITOR_PAGE;
  const entry = () => files[cur];
  const doc = () => files[cur]?.doc ?? null;
  const n = (k: number, word: string, plural = word + 's') => `${k} ${k === 1 ? word : plural}`;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const okFiles = () => files.filter((f) => f.doc);

  // ---------- tabs and symptoms ----------

  function setTab(id: string) {
    mode = id;
    root.querySelectorAll<HTMLElement>('[data-tab]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === id)));
    root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== id));
    $('preview').hidden = id === 'edit';
    if (id === 'edit') renderEditor();
    if (id === 'encoding') renderCands();
    render();
  }
  root.querySelectorAll<HTMLElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => setTab(b.dataset.tab!)));
  root.querySelectorAll<HTMLInputElement>('input[name="sym"]').forEach((r) =>
    r.addEventListener('change', () => {
      if (r.checked) setTab(r.dataset.go!);
    }),
  );
  // Links elsewhere on the page ("which fix do I need") open a tab in place.
  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-go-tab]');
    if (!t) return;
    e.preventDefault();
    const id = t.dataset.goTab!;
    const r = root.querySelector<HTMLInputElement>(`input[name="sym"][value="${t.dataset.sym ?? ''}"]`) ?? root.querySelector<HTMLInputElement>(`input[name="sym"][data-go="${id}"]`);
    if (r) r.checked = true;
    setTab(id);
    root.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  setTab(mode);

  // ---------- loading ----------

  async function loadEntry(f: Entry, forced = '') {
    f.forced = forced;
    try {
      let { text, encoding } = await decode(f.buf, forced || undefined);
      // jschardet can be unsure on short files. If another code page reads clearly better, use it.
      if (!forced && !/^utf/i.test(encoding)) {
        const best = encodingCandidates(f.buf, ENCODINGS)[0];
        if (best && best.score < garbleScore(text)) ({ text, encoding } = best);
      }
      const fpsFrom = parseFloat($<HTMLSelectElement>('fpsFrom').value) || 23.976;
      f.doc = parse(text, fpsFrom);
      f.encoding = encoding;
      f.error = '';
      f.edited = false;
    } catch (e: any) {
      f.doc = null;
      f.error = e?.message ?? String(e);
    }
  }

  async function takeFiles(list: FileList | File[]) {
    const err = $('loadError');
    err.hidden = true;
    const all = [...list];
    if (!all.length) return;
    const msgs: string[] = [];
    if (all.length > 100) msgs.push(`Only the first 100 of ${all.length} files were loaded.`);
    const next: Entry[] = [];
    for (const f of all.slice(0, 100)) {
      if (f.size > 20 * 1024 * 1024) {
        msgs.push(`${f.name} is over 20 MB, which is far bigger than a subtitle file should be.`);
        continue;
      }
      const e: Entry = { name: f.name, buf: await f.arrayBuffer(), doc: null, encoding: '', forced: '', edited: false, error: '' };
      await loadEntry(e);
      if (!e.doc) msgs.push(`${f.name}: ${e.error}`);
      next.push(e);
    }
    if (!next.some((f) => f.doc)) {
      err.textContent = msgs.join(' ') || "This doesn't look like a subtitle file we can read.";
      err.hidden = false;
      return;
    }
    files = next.filter((f) => f.doc);
    cur = 0;
    const note = $('fileNote');
    note.textContent = msgs.join(' ');
    note.hidden = !msgs.length;
    const preset = root.dataset.out;
    const d = files[0].doc!;
    outFmt.value = preset || (SUB_FORMATS.includes(d.format) ? d.format : 'srt');
    showFile();
    $('pick').hidden = true;
    drop.hidden = true;
    $('loaded').hidden = false;
  }

  function showFile() {
    const f = entry();
    const d = f.doc!;
    const many = files.length > 1;
    $('fname').hidden = many;
    $('fname').textContent = f.name;
    $('filePickWrap').hidden = !many;
    if (many) {
      const pick = $<HTMLSelectElement>('filePick');
      if (pick.options.length !== files.length) {
        pick.innerHTML = '';
        files.forEach((x, i) => pick.add(new Option(x.name, String(i))));
      }
      pick.value = String(cur);
      $('fileCount').textContent = `${files.length} files, showing`;
    }
    const c = d.captions;
    $('fmeta').textContent = `${FORMAT_LABEL[d.format] ?? d.format} · ${n(c.length, 'line')} · ${fmtTime(c[0].start)} → ${fmtTime(c[c.length - 1].end)} · read as ${f.encoding}`;
    encSel.value = f.forced;
    f.cands = undefined;
    fillLineSelects();
    editorLimit = EDITOR_PAGE;
    if (mode === 'edit') renderEditor();
    if (mode === 'encoding') renderCands();
    render();
  }

  function fillLineSelects() {
    const d = doc();
    if (!d) return;
    const l1 = $<HTMLSelectElement>('l1');
    const l2 = $<HTMLSelectElement>('l2');
    const fl = $<HTMLSelectElement>('fromLine');
    const keep = fl.value;
    l1.innerHTML = l2.innerHTML = fl.innerHTML = '';
    fl.add(new Option('Line 1 (shift every line)', '0'));
    d.captions.forEach((c, i) => {
      const label = `${i + 1}. ${fmtTime(c.start)}  ${stripTags(c.text).replace(/\n/g, ' ').slice(0, 40)}`;
      l1.add(new Option(label, String(i)));
      l2.add(new Option(label, String(i)));
      if (i) fl.add(new Option(label, String(i)));
    });
    l1.value = '0';
    l2.value = String(d.captions.length - 1);
    fl.value = keep && +keep < d.captions.length ? keep : '0';
    $<HTMLInputElement>('t1').value = fmtTime(d.captions[0].start);
    $<HTMLInputElement>('t2').value = fmtTime(d.captions[d.captions.length - 1].start);
  }

  // ---------- computing ----------

  function timeFn(d: Doc): TimeFn | null {
    if (mode === 'shift') {
      const raw = $<HTMLInputElement>('offset').value.trim();
      const ms = /^-?\d+(\.\d+)?$/.test(raw) ? Math.round(parseFloat(raw) * 1000) : parseTime(raw);
      if (isNaN(ms)) throw new Error('Enter the offset in seconds (like 2.5 or -1) or as a time (00:00:02,500).');
      return shiftFn(ms);
    }
    if (mode === 'fps') {
      const a = parseFloat($<HTMLSelectElement>('fpsFrom').value);
      const b = parseFloat($<HTMLSelectElement>('fpsTo').value);
      const pct = ((a / b - 1) * 100).toFixed(2);
      $('fpsHint').textContent = a === b ? 'Same frame rate, nothing will change.' : `Every time is multiplied by ${(a / b).toFixed(5)} (${+pct > 0 ? '+' : ''}${pct}%).`;
      return fpsFn(a, b);
    }
    if (mode === 'sync') {
      const i1 = +$<HTMLSelectElement>('l1').value;
      const i2 = +$<HTMLSelectElement>('l2').value;
      const t1 = parseTime($<HTMLInputElement>('t1').value);
      const t2 = parseTime($<HTMLInputElement>('t2').value);
      if (isNaN(t1) || isNaN(t2)) throw new Error('Type both target times, like 00:01:23,400.');
      if (i1 === i2) throw new Error('Pick two different lines.');
      return twoPointFn(d.captions[i1].start, t1, d.captions[i2].start, t2);
    }
    return null;
  }

  /** Shift from a chosen line: the time of that line in the file on screen, applied to every file. */
  function fromMs(): number {
    if (mode !== 'shift') return -Infinity;
    const i = +$<HTMLSelectElement>('fromLine').value;
    return i > 0 ? doc()!.captions[i]?.start ?? -Infinity : -Infinity;
  }

  function cleanOpts() {
    const on = (id: string) => $<HTMLInputElement>(id).checked;
    return {
      removeBrackets: on('brackets'), removeSpeakers: on('speakers'), removeMusic: on('music'), removeTags: on('tags'),
      removeDuplicates: on('dupes'), fixOverlaps: on('overlaps'), minDurationMs: on('mindur') ? 700 : 0,
    };
  }

  function compute(f: Entry, report = false): { caps: Caption[]; text: string | null } {
    const d = f.doc!;
    const fmt = outFmt.value;
    const fn = timeFn(d);
    const from = fromMs();
    let caps = d.captions;
    if (fn) caps = retime(caps, fn, from);
    if (mode === 'clean') {
      const { captions, report: r } = fixCommon(caps, cleanOpts());
      caps = captions;
      if (report) {
        const parts = [];
        if (r.hiRemoved) parts.push(`text removed from ${n(r.hiRemoved, 'line')}`);
        if (r.removedEmpty) parts.push(`${n(r.removedEmpty, 'empty line')} deleted`);
        if (r.merged) parts.push(`${n(r.merged, 'repeated line')} merged`);
        if (r.fixedOverlaps) parts.push(`${n(r.fixedOverlaps, 'overlap')} fixed`);
        if (r.extended) parts.push(`${n(r.extended, 'short line')} lengthened`);
        if (r.sorted) parts.push('lines put back in time order');
        $('cleanReport').textContent = parts.length ? (parts.join(' · ') + '.').replace(/^./, (c) => c.toUpperCase()) : 'Nothing needed fixing with these options.';
      }
    }
    if (isDocFormat(fmt)) return { caps, text: null };
    const ass = d.format === 'ass' || d.format === 'ssa';
    // Same ASS/SSA format and a timing-only change: rewrite in place so styling survives.
    if (ass && fmt === d.format && mode !== 'clean' && !f.edited) return { caps, text: fn ? retimeAssRaw(d.raw, fn, from) : d.raw };
    // Only the characters were wrong: keep the file exactly as it was, now in UTF-8.
    if (mode === 'encoding' && fmt === d.format && !f.edited) return { caps, text: d.raw };
    return { caps, text: build(caps, fmt as OutFormat) };
  }

  function render() {
    const d = doc();
    if (!d) return;
    updateBatchNote();
    const err = $('opError');
    try {
      const { caps } = compute(entry(), true);
      err.hidden = true;
      if (mode === 'edit') return;
      const before = d.captions;
      const timed = mode !== 'clean';
      const show = timed ? before.slice(0, 6).concat(before.length > 12 ? before.slice(-6) : before.slice(6)) : caps.slice(0, 12);
      const plainOut = isDocFormat(outFmt.value) || outFmt.value === 'sbv';
      const rows = show.map((c) => {
        const i = timed ? before.indexOf(c) : caps.indexOf(c);
        const after = timed ? caps[i] : c;
        const text = plainOut ? esc(stripTags(after.text)) : esc(after.text);
        return `<tr><td>${i + 1}</td><td>${timed ? fmtTime(c.start) : ''}</td><td>${fmtTime(after.start)}</td><td>${text.replace(/\n/g, '<br>')}</td></tr>`;
      });
      $('rows').innerHTML = rows.join('');
    } catch (e: any) {
      $('rows').innerHTML = '';
      err.textContent = e?.message ?? String(e);
      err.hidden = false;
    }
  }

  function targets(): Entry[] {
    return BATCH_MODES.has(mode) ? okFiles() : [entry()];
  }

  function updateBatchNote() {
    const many = files.length > 1;
    const t = targets();
    $('download').textContent = t.length > 1 ? `Download ${t.length} files as a zip` : 'Download fixed file';
    const note = $('batchNote');
    note.hidden = !many;
    if (!many) return;
    note.textContent = BATCH_MODES.has(mode)
      ? `These settings apply to all ${files.length} files. The preview shows ${entry().name}.${mode === 'shift' && +$<HTMLSelectElement>('fromLine').value > 0 ? ' "Starting at line" uses that line’s time in every file.' : ''}`
      : `This fix works on one file at a time, so only ${entry().name} is downloaded.`;
  }

  function outName(f: Entry, fmt: string) {
    const base = f.name.replace(/\.[^.]+$/, '');
    const ext = isDocFormat(fmt) ? DOC_FORMATS.find((d) => d.value === fmt)!.ext : fmt;
    const srcExt = (f.name.match(/\.([^.]+)$/)?.[1] ?? '').toLowerCase();
    return srcExt === ext ? `${base}.fixed.${ext}` : `${base}.${ext}`;
  }

  async function produce(f: Entry): Promise<string | Uint8Array> {
    const fmt = outFmt.value;
    const { caps, text } = compute(f);
    if (text !== null) return text;
    return exportDoc(caps, fmt as DocFormat, f.name.replace(/\.[^.]+$/, ''));
  }

  function save(data: string | Uint8Array, name: string, type: string) {
    const blob = new Blob([data as BlobPart], { type });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = name;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 2000);
  }

  async function download() {
    const err = $('opError');
    const btn = $<HTMLButtonElement>('download');
    try {
      btn.disabled = true;
      const fmt = outFmt.value;
      const list = targets();
      if (list.length === 1) {
        const data = await produce(list[0]);
        const mime = isDocFormat(fmt) ? DOC_FORMATS.find((d) => d.value === fmt)!.mime : 'text/plain;charset=utf-8';
        save(data, outName(list[0], fmt), mime);
      } else {
        const out = [];
        for (const f of list) out.push({ name: outName(f, fmt), data: await produce(f) });
        save(await zipFiles(out), 'subtitles-fixed.zip', 'application/zip');
      }
      (window as any).plausible?.('download', { props: { mode, fmt, files: String(list.length) } });
    } catch (e: any) {
      err.textContent = e?.message ?? String(e);
      err.hidden = false;
    } finally {
      btn.disabled = false;
    }
  }

  // ---------- fix characters ----------

  function renderCands() {
    const f = entry();
    if (!f) return;
    f.cands ??= encodingCandidates(f.buf, ENCODINGS);
    const list = $('candList');
    const li = $<HTMLSelectElement>('lang').value;
    let cands = f.cands;
    if (li !== '') {
      const encs = new Set(LANG_ENCODINGS[+li].encs.map((e) => e.toLowerCase()));
      cands = cands.filter((c) => encs.has(c.encoding.toLowerCase()) || /^utf-8/i.test(c.encoding));
    } else cands = cands.slice(0, 6);
    if (!f.cands.some((c) => c.sample.length)) {
      list.innerHTML = '<p class="hint">This file only uses plain English letters, so every encoding reads it the same way. Nothing to fix here.</p>';
      return;
    }
    const langOf = (e: string) => (e === REPAIR_UTF8 ? 'fixes text saved twice, like CafÃ©' : /^utf-8$/i.test(e) ? 'standard' : LANG_ENCODINGS.find((l) => l.encs.some((x) => x.toLowerCase() === e.toLowerCase()))?.lang.replace(/ \(.*/, '') ?? '');
    const current = (f.forced || f.encoding).toLowerCase();
    list.innerHTML = cands
      .map((c) => {
        const id = `cand-${c.encoding.replace(/\W/g, '')}`;
        return `<label class="cand" for="${id}"><input type="radio" name="cand" id="${id}" value="${esc(c.encoding)}"${c.encoding.toLowerCase() === current ? ' checked' : ''} />
          <span class="cand-name">${esc(c.encoding)}<span class="cand-lang">${esc(langOf(c.encoding))}</span></span>
          <span class="cand-sample">${c.sample.map(esc).join('<br>') || '<em>no accented letters</em>'}</span></label>`;
      })
      .join('');
  }
  $('candList').addEventListener('change', async (e) => {
    const r = e.target as HTMLInputElement;
    if (r.name !== 'cand') return;
    await loadEntry(entry(), r.value);
    const keep = entry().cands;
    showFile();
    entry().cands = keep;
    renderCands();
  });
  $('lang').addEventListener('change', renderCands);

  // ---------- check and edit ----------

  function renderChecks() {
    const f = entry();
    const d = f.doc!;
    const issues = validate(d.captions);
    const items: string[] = [];
    if (d.format === 'srt' && !f.edited) for (const r of checkSrtRaw(d.raw).slice(0, 30)) items.push(`Line ${r.line} of the file: ${esc(r.text)}`);
    const counts = new Map<string, number>();
    for (const i of issues) counts.set(i.text, (counts.get(i.text) ?? 0) + 1);
    for (const [t, k] of counts) items.push(`${esc(t)}: ${n(k, 'line')}`);
    if (!/^utf-?8$/i.test(f.encoding)) items.push(`The file is ${esc(f.encoding)}, not UTF-8. Downloads are saved as UTF-8.`);
    $('checks').innerHTML = items.length
      ? `<p class="checks-head">${n(items.length, 'thing', 'things')} to look at</p><ul>${items.map((t) => `<li>${t}</li>`).join('')}</ul>`
      : '<p class="checks-head">No problems found.</p>';
    return issues;
  }

  function issueMap(issues = validate(doc()!.captions)) {
    const m = new Map<number, string[]>();
    for (const i of issues) m.set(i.index, [...(m.get(i.index) ?? []), i.text]);
    return m;
  }

  function renderEditor() {
    const d = doc();
    if (!d) return;
    const issues = issueMap(renderChecks());
    const only = $<HTMLInputElement>('onlyIssues').checked;
    const idx = d.captions.map((_, i) => i).filter((i) => !only || issues.has(i));
    const shown = idx.slice(0, editorLimit);
    $('editor').innerHTML = shown.length
      ? shown
          .map((i) => {
            const c = d.captions[i];
            const iss = issues.get(i);
            return `<div class="erow" data-i="${i}">
          <span class="enum">${i + 1}</span>
          <input class="etime" data-f="start" value="${fmtTime(c.start)}" aria-label="Start of line ${i + 1}" spellcheck="false" />
          <input class="etime" data-f="end" value="${fmtTime(c.end)}" aria-label="End of line ${i + 1}" spellcheck="false" />
          <span class="eact"><button type="button" class="link" data-act="add">Add below</button><button type="button" class="link" data-act="del">Delete</button></span>
          <textarea data-f="text" rows="${Math.max(1, c.text.split('\n').length)}" aria-label="Text of line ${i + 1}">${esc(c.text)}</textarea>
          <p class="eissue">${iss ? esc(iss.join('. ')) : ''}</p>
        </div>`;
          })
          .join('')
      : `<p class="hint">${only ? 'No lines with problems.' : 'No lines.'}</p>`;
    $('moreRows').hidden = idx.length <= editorLimit;
    $('moreRows').textContent = `Show more lines (${idx.length - Math.min(idx.length, editorLimit)} hidden)`;
  }

  function refreshIssues() {
    const issues = issueMap(renderChecks());
    $('editor').querySelectorAll<HTMLElement>('.erow').forEach((row) => {
      const iss = issues.get(+row.dataset.i!);
      row.querySelector('.eissue')!.textContent = iss ? iss.join('. ') : '';
    });
  }

  function edited() {
    const f = entry();
    f.edited = true;
    f.cands = undefined;
  }

  const editor = $('editor');
  editor.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement | HTMLTextAreaElement;
    const i = +(t.closest<HTMLElement>('.erow')?.dataset.i ?? -1);
    const c = doc()?.captions[i];
    if (!c) return;
    if (t.dataset.f === 'text') {
      c.text = t.value;
      (t as HTMLTextAreaElement).rows = Math.max(1, t.value.split('\n').length);
      edited();
    }
  });
  editor.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    const i = +(t.closest<HTMLElement>('.erow')?.dataset.i ?? -1);
    const c = doc()?.captions[i];
    if (!c) return;
    if (t.dataset.f === 'start' || t.dataset.f === 'end') {
      const ms = parseTime(t.value);
      t.setAttribute('aria-invalid', String(isNaN(ms)));
      if (isNaN(ms)) return;
      c[t.dataset.f] = ms;
      t.value = fmtTime(ms);
      edited();
    }
    refreshIssues();
  });
  editor.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-act]');
    if (!b) return;
    const d = doc()!;
    const i = +b.closest<HTMLElement>('.erow')!.dataset.i!;
    if (b.dataset.act === 'del') {
      if (d.captions.length === 1) return;
      d.captions.splice(i, 1);
    } else {
      const c = d.captions[i];
      const next = d.captions[i + 1];
      const start = c.end + 1;
      const end = next ? Math.max(start, Math.min(start + 2000, next.start - 1)) : start + 2000;
      d.captions.splice(i + 1, 0, { start, end, text: '' });
    }
    edited();
    fillLineSelects();
    renderEditor();
    const focusRow = editor.querySelector<HTMLElement>(`.erow[data-i="${b.dataset.act === 'del' ? Math.min(i, d.captions.length - 1) : i + 1}"] textarea`);
    focusRow?.focus();
  });
  $('addEnd').addEventListener('click', () => {
    const d = doc()!;
    const last = d.captions[d.captions.length - 1];
    d.captions.push({ start: last.end + 1, end: last.end + 2001, text: '' });
    edited();
    $<HTMLInputElement>('onlyIssues').checked = false;
    editorLimit = Math.max(editorLimit, d.captions.length);
    fillLineSelects();
    renderEditor();
    editor.querySelector<HTMLTextAreaElement>('.erow:last-child textarea')?.focus();
  });
  $('moreRows').addEventListener('click', () => {
    editorLimit += EDITOR_PAGE;
    renderEditor();
  });
  $('onlyIssues').addEventListener('change', () => {
    editorLimit = EDITOR_PAGE;
    renderEditor();
  });

  // ---------- wiring ----------

  fileInput.addEventListener('change', () => fileInput.files?.length && takeFiles(fileInput.files));
  ['dragenter', 'dragover'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.add('over'); }));
  ['dragleave', 'drop'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.remove('over'); }));
  // Accept drops anywhere on the page.
  window.addEventListener('dragover', (e) => e.preventDefault());
  window.addEventListener('drop', (e) => {
    e.preventDefault();
    const fl = e.dataTransfer?.files;
    if (fl?.length) takeFiles(fl);
  });

  encSel.addEventListener('change', async () => {
    await loadEntry(entry(), encSel.value);
    showFile();
  });
  $('filePick').addEventListener('change', () => {
    cur = +$<HTMLSelectElement>('filePick').value;
    showFile();
  });
  $('reset').addEventListener('click', () => {
    files = [];
    fileInput.value = '';
    $<HTMLSelectElement>('filePick').innerHTML = '';
    $('loaded').hidden = true;
    $('fileNote').hidden = true;
    drop.hidden = false;
    $('pick').hidden = false;
  });
  $('download').addEventListener('click', download);
  $('swap').addEventListener('click', () => {
    const a = $<HTMLSelectElement>('fpsFrom'), b = $<HTMLSelectElement>('fpsTo');
    [a.value, b.value] = [b.value, a.value];
    render();
  });
  root.querySelectorAll<HTMLElement>('[data-nudge]').forEach((b) =>
    b.addEventListener('click', () => {
      const o = $<HTMLInputElement>('offset');
      const cur = parseFloat(o.value) || 0;
      o.value = String(Math.round((cur + +b.dataset.nudge! / 1000) * 1000) / 1000);
      render();
    }),
  );
  const quiet = new Set(['enc', 'file', 'filePick', 'lang', 'onlyIssues']);
  const inPanel = (el: HTMLElement) => el.closest('#editor, #candList, .pick');
  root.addEventListener('input', (e) => {
    const t = e.target as HTMLElement;
    if (!quiet.has(t.id) && !inPanel(t)) render();
  });
  root.addEventListener('change', (e) => {
    const t = e.target as HTMLElement;
    if (!quiet.has(t.id) && !inPanel(t)) render();
  });
</script>
