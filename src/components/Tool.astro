---
import type { Mode } from '../site';
import { LANG_ENCODINGS } from '../lib/subs';
import { DOC_FORMATS } from '../lib/export';
import { OCR_LANGS } from '../lib/ocr';
interface Props {
  mode: Mode;
  preset?: { from?: number; to?: number; out?: string; fromLine?: boolean; merge?: 'stack' | 'parts'; symptom?: string; clean?: 'dupes' | 'renumber'; video?: boolean };
  home?: boolean;
  h1: string;
  lede: string;
}
const { mode, preset = {}, home = false, h1, lede } = Astro.props;
type Group = 'timing' | 'text' | 'convert';
const GROUP_OF: Record<Mode, Group> = { shift: 'timing', fps: 'timing', sync: 'timing', timing: 'timing', encoding: 'text', clean: 'text', reading: 'text', replace: 'text', edit: 'text', convert: 'convert', merge: 'convert' };
const tabs: { id: Mode; label: string }[] = [
  { id: 'shift', label: 'Shift timing' },
  { id: 'fps', label: 'Change frame rate' },
  { id: 'sync', label: 'Sync two points' },
  { id: 'timing', label: 'Fix timing' },
  { id: 'encoding', label: 'Fix characters' },
  { id: 'clean', label: 'Clean up' },
  { id: 'reading', label: 'Reading speed' },
  { id: 'replace', label: 'Find and replace' },
  { id: 'edit', label: 'Check and edit' },
  { id: 'convert', label: 'Convert format' },
  { id: 'merge', label: 'Merge files' },
];
const LABEL = Object.fromEntries(tabs.map((t) => [t.id, t.label])) as Record<Mode, string>;
// The symptom picker. Each answer opens one of the tabs above, in place. Grouped into rolls so more fixes slot in.
const symptoms: { id: string; go: Mode; text: string }[] = [
  { id: 'early-late', go: 'shift', text: 'Early or late by the same amount the whole way through' },
  { id: 'one-scene', go: 'shift', text: 'Fine at first, then off from one scene onward' },
  { id: 'drift', go: 'fps', text: 'A little off at the start and worse as the video goes on' },
  { id: 'flicker', go: 'timing', text: 'Lines overlap, flash past or hang on screen too long' },
  { id: 'garbled', go: 'encoding', text: 'Letters show up as Ã©, Ð¿ or question marks' },
  { id: 'sdh', go: 'clean', text: 'Full of [MUSIC], (laughs) and speaker names' },
  { id: 'too-fast', go: 'reading', text: 'Too many words to read before the line is gone' },
  { id: 'typo', go: 'replace', text: 'The same name or typo is wrong all the way through' },
  { id: 'broken', go: 'edit', text: 'The player skips lines or will not open the file' },
  { id: 'format', go: 'convert', text: 'Wrong format for my player, website or editor' },
  { id: 'transcript', go: 'convert', text: 'All I have is a text transcript with no timings' },
  { id: 'merge', go: 'merge', text: 'Two files I want as one: two languages, or CD1 and CD2' },
];
const ROLLS: { g: Group; name: string }[] = [
  { g: 'timing', name: 'Timing' },
  { g: 'text', name: 'Text' },
  { g: 'convert', name: 'Format' },
];
const picked = home ? '' : preset.symptom ?? (preset.fromLine ? 'one-scene' : symptoms.find((s) => s.go === mode)?.id ?? '');
const fps = [
  { v: String(24000 / 1001), l: '23.976' },
  { v: '24', l: '24' },
  { v: '25', l: '25 (PAL)' },
  { v: String(30000 / 1001), l: '29.97' },
  { v: '30', l: '30' },
];
const cleanOnly = preset.clean;
const cleanOn = (k: string) => (cleanOnly ? cleanOnly === 'dupes' && k === 'dupes' : !['tags'].includes(k));
const from = String(preset.from ?? 25);
const to = String(preset.to ?? 24000 / 1001);
const FORMATS = ['SRT', 'VTT', 'ASS', 'SSA', 'SUB', 'SBV', 'SMI', 'TTML', 'DFXP', 'XML', 'STL', 'SUP', 'LRC', 'TXT'];
const ACCEPT = '.srt,.vtt,.ass,.ssa,.sub,.sbv,.smi,.sami,.lrc,.ttml,.dfxp,.xml,.stl,.sup,.txt';

// Ticket drawings. One fixed scale for all of them: 240 x 64, cue lane on top, speech underneath,
// so every problem reads against the same timeline.
const SPEECH = [[20, 70], [100, 150], [180, 225]];
const wave = (spans = SPEECH) => {
  let d = '';
  for (let x = 6; x < 236; x += 5) {
    const on = spans.some(([a, b]) => x >= a && x <= b);
    const h = on ? 6 + ((x * 7) % 13) : 1.5 + ((x * 3) % 3);
    d += `M${x} ${50 - h / 2}v${h}`;
  }
  return `<path class="wv" d="${d}"/>`;
};
const cue = (a: number, b: number, ghost = false) =>
  ghost ? `<rect class="gh" x="${a}" y="14" width="${b - a}" height="14" rx="3"/>` : `<rect class="cu" x="${a}" y="14" width="${Math.min(b, 236) - a}" height="14" rx="3"/>`;
const shifted = (offs: number[]) => SPEECH.map(([a, b], i) => (offs[i] ? cue(a, b, true) : '') + cue(a + offs[i], b + offs[i])).join('');
const ART: Record<string, string> = {
  'early-late': shifted([24, 24, 24]) + wave(),
  'one-scene': `<path class="cut" d="M86 6V60"/>` + shifted([0, 24, 24]) + wave(),
  drift: shifted([0, 10, 24]) + wave(),
  flicker: cue(20, 80) + `<rect class="cu ov" x="68" y="14" width="56" height="14" rx="3"/>` + cue(146, 150) + cue(176, 236) + `<path class="arrow" d="M176 40h60"/>` + wave([[20, 120], [146, 160], [176, 200]]),
  'too-fast': cue(96, 200, true) + cue(96, 124) + `<text x="20" y="25">0.4 s</text><text x="206" y="25" class="warn">!</text>` + wave([[96, 200]]),
  typo: `<text x="20" y="25">Jon</text><path class="strike" d="M18 21H50"/><path class="arrow" d="M60 21h28m-7-6 7 6-7 6"/><text x="98" y="25" class="keep">John</text><text x="150" y="25">every line</text>` + wave(),
  garbled: `<rect class="cu" x="20" y="10" width="205" height="22" rx="3"/><text class="inv" x="122" y="25.5" text-anchor="middle">CafÃ© Ð¿Ñ€Ð¸</text>` + wave(),
  sdh: `<text x="20" y="25">[MUSIC]</text><path class="strike" d="M18 21H82"/><text x="92" y="25">JOHN:</text><path class="strike" d="M90 21H138"/><text x="148" y="25" class="keep">Hello?</text>` + wave(),
  broken: `<rect class="cu" x="20" y="14" width="80" height="14" rx="3"/><rect class="cu ov" x="78" y="14" width="72" height="14" rx="3"/><text class="inv" x="40" y="25">3</text><text class="inv" x="122" y="25">2</text><text x="168" y="25" class="warn">2 before 3</text>` + wave(),
  transcript: `<path class="tx" d="M20 12h82M20 19h64M20 26h74"/><path class="arrow" d="M112 19h30m-7-6 7 6-7 6"/>` + cue(152, 186) + cue(192, 228) + wave([[150, 188], [192, 230]]),
  merge: `<rect class="gh" x="20" y="6" width="56" height="10" rx="2"/><rect class="gh" x="20" y="22" width="56" height="10" rx="2"/><path class="arrow" d="M86 19h30m-7-6 7 6-7 6"/><rect class="cu" x="126" y="9" width="96" height="21" rx="3"/><path class="tx inv" d="M134 16h80M134 23h64"/>` + wave(),
  format: `<rect class="gh" x="20" y="11" width="62" height="20" rx="3"/><text x="51" y="25.5" text-anchor="middle">.ass</text><path class="arrow" d="M92 21h46m-7-6 7 6-7 6"/><rect class="cu" x="148" y="11" width="62" height="20" rx="3"/><text class="inv" x="179" y="25.5" text-anchor="middle">.srt</text>` + wave(),
};
---

<section class="tool" id="tool" data-mode={mode} data-group={GROUP_OF[mode]} data-out={preset.out ?? ''} data-symptom={picked}>
  <div class="hero">
    <div class="hero-copy">
      <h1 set:html={h1.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!).replace(/\S*-\S*/g, (w) => `<span class="nobr">${w}</span>`)} />
      <p class="lede">{lede}</p>

      <label class="drop" id="drop">
        <input type="file" id="file" class="visually-hidden" multiple accept={ACCEPT} />
        <span class="drop-stub" aria-hidden="true"><span>Admit one or many</span></span>
        <span class="drop-body">
          <span class="drop-main">Drop subtitle files here</span>
          <span class="drop-sub">One file or a whole season. Nothing leaves your device.</span>
          <span class="chips" aria-label="Formats it reads">{FORMATS.map((f) => <span class="chip">{f}</span>)}</span>
          <span class="drop-row">
            <span class="drop-btn" aria-hidden="true">Choose files</span>
            <span class="drop-fix" id="dropFix" aria-live="polite">{picked ? `Fix: ${LABEL[mode]}` : ''}</span>
          </span>
        </span>
      </label>
      <ul class="trust" aria-label="The deal"><li>Free</li><li>No upload</li><li>No sign-up</li></ul>
      <p class="error" id="loadError" hidden></p>
      <div class="ocr" id="ocr" hidden aria-live="polite">
        <p class="ocr-msg" id="ocrMsg"></p>
        <progress id="ocrBar" max="1" value="0"></progress>
        <p class="hint">Picture subtitles hold images, not text, so the words are read with OCR. It takes a while and gets some letters wrong, so check the lines before you download. Your file stays on this device. Only the reader itself is downloaded.</p>
        <button type="button" class="link" id="ocrStop">Stop</button>
      </div>
    </div>

    <figure class="screen" aria-hidden="true">
      <svg class="frame" viewBox="0 0 640 300" preserveAspectRatio="xMidYMid slice">
        <rect width="640" height="300" class="sky" />
        <circle cx="508" cy="70" r="24" class="moon" />
        <path class="city" d="M0 210h40v-46h34v28h22v-64h46v52h18v-30h40v60h30v-90h52v70h26v-40h44v56h20v-24h48v38h36v-72h56v80h28v-34h40v32h40V300H0z" />
        <g class="lit">
          <rect x="102" y="140" width="8" height="10" /><rect x="122" y="160" width="8" height="10" /><rect x="292" y="132" width="8" height="10" /><rect x="312" y="152" width="8" height="10" />
          <rect x="292" y="172" width="8" height="10" /><rect x="498" y="150" width="8" height="10" /><rect x="518" y="170" width="8" height="10" /><rect x="190" y="182" width="8" height="10" />
        </g>
        <text x="320" y="268" text-anchor="middle" class="line">I said ten o'clock, not ten past.</text>
      </svg>
      <svg class="lanes" viewBox="0 0 640 92">
        <text x="0" y="30" class="lab">Subtitle</text>
        <text x="0" y="72" class="lab">Speech</text>
        <path class="track" d="M84 22H640M84 66H640" />
        <rect class="ghost" x="330" y="12" width="168" height="22" rx="4" />
        <g class="snap"><rect class="cue" x="250" y="12" width="168" height="22" rx="4" /><text x="334" y="28" text-anchor="middle" class="cuetext">ten o'clock</text></g>
        <path class="speech" d={(() => { let d = ''; for (let x = 88; x < 638; x += 6) { const on = x >= 250 && x <= 418; const h = on ? 10 + ((x * 7) % 22) : 2 + ((x * 3) % 4); d += `M${x} ${66 - h / 2}v${h}`; } return d; })()} />
        <path class="head" d="M250 4V88" />
      </svg>
      <figcaption>Speech and subtitle, lined up again</figcaption>
    </figure>
  </div>

  <fieldset class="pick" id="pick">
    <legend>What is wrong with your subtitles?</legend>
    <div class="rolls">
      {ROLLS.map((r) => (
        <div class="roll" data-group={r.g}>
          <p class="roll-name">{r.name}</p>
          <div class="tickets">
            {symptoms.filter((s) => GROUP_OF[s.go] === r.g).map((s) => (
              <label class="tk" data-group={r.g}>
                <input type="radio" name="sym" class="visually-hidden" value={s.id} data-go={s.go} checked={s.id === picked} />
                <span class="tk-stub" aria-hidden="true"><span>{LABEL[s.go]}</span></span>
                <span class="tk-paper">
                  <svg class="tk-art" viewBox="0 0 240 64" aria-hidden="true" set:html={ART[s.id]} />
                  <span class="tk-text">{s.text}</span>
                  <span class="tk-punch" aria-hidden="true">Picked</span>
                </span>
              </label>
            ))}
          </div>
        </div>
      ))}
    </div>
  </fieldset>

  <div class="loaded" id="loaded" hidden>
    <div class="fileinfo">
      <strong id="fname"></strong>
      <label class="filepick" id="filePickWrap" hidden><span id="fileCount"></span>
        <select id="filePick"></select>
      </label>
      <span id="fmeta"></span>
      <label class="enc">Encoding
        <select id="enc"><option value="">Auto</option></select>
      </label>
      <label class="link addfiles">Add files<input type="file" id="addFile" class="visually-hidden" multiple accept={ACCEPT} /></label>
      <button type="button" class="link" id="reset">Use other files</button>
    </div>
    <p class="note" id="fileNote" hidden></p>
    <div class="panel srcopts" id="srcOpts" hidden>
      <label id="srcFpsWrap" hidden>This file counts frames. Its video runs at
        <select id="srcFps">{fps.map((f) => <option value={f.v} selected={f.l === '23.976'}>{f.l} fps</option>)}</select>
      </label>
      <label id="ocrLangWrap" hidden>Language of the text in the pictures
        <select id="ocrLang">{OCR_LANGS.map((l) => <option value={l.v}>{l.l}</option>)}</select>
      </label>
      <label id="trackWrap" hidden>Language in this file
        <select id="track"></select>
      </label>
      <label id="txtCpsWrap" hidden>Reading speed
        <select id="txtCps"><option value="12">Slow</option><option value="15" selected>Normal</option><option value="18">Fast</option></select>
      </label>
      <label id="txtStartWrap" hidden>First line at
        <input id="txtStart" value="00:00:00,000" spellcheck="false" />
      </label>
      <p class="hint" id="srcHint"></p>
    </div>

    <div class="viewer" id="viewer">
      <div class="vscreen" id="vscreen"><video id="video" playsinline controls hidden></video><p class="vsub" id="vsub"></p></div>
      <div class="vctl" id="vctl" hidden>
        <span class="vnudge" role="group" aria-label="Move the subtitles">
          <span>Subtitles</span>
          <button type="button" data-vnudge="-1000">−1 s</button><button type="button" data-vnudge="-100">−0.1 s</button>
          <button type="button" data-vnudge="100">+0.1 s</button><button type="button" data-vnudge="1000">+1 s</button>
        </span>
        <span class="voff" id="vOff" aria-live="polite"></span>
        <button type="button" class="vlink" id="vClose">Close video</button>
      </div>
      <p class="vnote" id="vNote" hidden></p>
      <div class="vbar">
        <span class="vtime" id="vtime"></span>
        <label class={`vlink vpick${preset.video ? ' lead' : ''}`} id="vPick">Watch with your video<input type="file" id="videoFile" class="visually-hidden" accept="video/*,.mkv,.mov,.m4v" /></label>
        <span class="vkey"><i class="k-before"></i>Before <i class="k-after"></i>After</span>
      </div>
      <svg class="cuemap" id="cuemap" tabindex="0" role="slider" aria-label="Position in the subtitles. Arrow keys step through lines." aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" preserveAspectRatio="none">
        <path class="cm-before" id="cmBefore" />
        <path class="cm-after" id="cmAfter" />
        <path class="cm-issue" id="cmIssue" />
        <path class="cm-head" id="cmHead" />
      </svg>
    </div>

    <div class="tabs" role="tablist" aria-label="Fix">
      {tabs.map((t) => (
        <button type="button" role="tab" data-tab={t.id} data-group={GROUP_OF[t.id]} aria-selected={t.id === mode ? 'true' : 'false'}>{t.label}</button>
      ))}
    </div>

    <div class="counter">
    <div class="panel" data-panel="shift">
      <label>Offset
        <input id="offset" value="0" inputmode="decimal" placeholder="e.g. 2.5 or -00:00:01,200" />
      </label>
      <div class="nudges">
        <button type="button" data-nudge="-1000">−1 s</button>
        <button type="button" data-nudge="-100">−0.1 s</button>
        <button type="button" data-nudge="100">+0.1 s</button>
        <button type="button" data-nudge="1000">+1 s</button>
      </div>
      <label class="wide">Starting at line
        <select id="fromLine"></select>
      </label>
      <p class="hint">Positive shows subtitles later, negative sooner. Seconds, or a time like 00:01:05,300. To fix only the second half, start at the first wrong line.</p>
    </div>

    <div class="panel" data-panel="fps">
      <label>Subtitles were made for
        <select id="fpsFrom">{fps.map((f) => <option value={f.v} selected={f.v === from}>{f.l} fps</option>)}</select>
      </label>
      <button type="button" class="swap" id="swap" aria-label="Swap frame rates">⇄</button>
      <label>My video is
        <select id="fpsTo">{fps.map((f) => <option value={f.v} selected={f.v === to}>{f.l} fps</option>)}</select>
      </label>
      <p class="hint" id="fpsHint"></p>
    </div>

    <div class="panel" data-panel="sync">
      <div class="syncrow">
        <label>Early line <select id="l1"></select></label>
        <label>should appear at <input id="t1" placeholder="00:00:00,000" /></label>
      </div>
      <div class="syncrow">
        <label>Late line <select id="l2"></select></label>
        <label>should appear at <input id="t2" placeholder="00:00:00,000" /></label>
      </div>
      <p class="hint">Find each line in your video and type when it is actually spoken.</p>
    </div>

    <div class="panel stack" data-panel="encoding">
      <label>Language of the subtitles
        <select id="lang">
          <option value="">Not sure</option>
          {LANG_ENCODINGS.map((l, i) => <option value={String(i)}>{l.lang}</option>)}
        </select>
      </label>
      <fieldset class="cands" id="cands"><legend>Pick the version that reads correctly</legend><div id="candList"></div></fieldset>
      <p class="hint">Whichever you pick, the download is saved as UTF-8, which every current player reads.</p>
    </div>

    <div class="panel stack" data-panel="clean">
      <label class="check"><input type="checkbox" id="brackets" checked={cleanOn('brackets')} /> Sound descriptions in brackets: [door slams], (laughs)</label>
      <label class="check"><input type="checkbox" id="speakers" checked={cleanOn('speakers')} /> Speaker names at the start of a line: JOHN:</label>
      <label class="check"><input type="checkbox" id="music" checked={cleanOn('music')} /> Music and song lines: ♪ la la ♪</label>
      <label class="check"><input type="checkbox" id="tags" checked={cleanOn('tags')} /> Formatting tags: &lt;i&gt;, &lt;font&gt;, {'{\\an8}'}</label>
      <label class="check"><input type="checkbox" id="dupes" checked={cleanOn('dupes')} /> The same line repeated back to back</label>
      <label class="check"><input type="checkbox" id="overlaps" checked={cleanOn('overlaps')} /> Fix overlapping lines</label>
      <label class="check"><input type="checkbox" id="mindur" checked={cleanOn('mindur')} /> Keep each line on screen at least 0.7 s</label>
      <p class="hint" id="cleanReport"></p>
      <p class="hint">Lines are put back in time order and numbered again from the first one. To start at another number, change it next to Save as.</p>
    </div>

    <div class="panel stack" data-panel="timing">
      <label class="check"><input type="checkbox" id="tOverlap" checked /> Fix lines that overlap</label>
      <div class="optrow">
        <label>Gap between lines
          <select id="tGap"><option value="0">None</option><option value="42">1 frame</option><option value="83" selected>2 frames</option><option value="125">3 frames</option></select>
        </label>
        <label>Shortest time on screen
          <select id="tMin"><option value="0">No minimum</option><option value="700">0.7 s</option><option value="1000" selected>1 s</option><option value="1500">1.5 s</option></select>
        </label>
        <label>Longest time on screen
          <select id="tMax"><option value="0">No limit</option><option value="5000">5 s</option><option value="7000" selected>7 s</option><option value="10000">10 s</option></select>
        </label>
      </div>
      <label class="check"><input type="checkbox" id="tRead" checked /> Give lines too wordy for their time a little longer, where the next line allows</label>
      <p class="hint" id="timingReport"></p>
    </div>

    <div class="panel stack" data-panel="reading">
      <div class="optrow">
        <label>Reading speed limit
          <select id="rCps"><option value="15">15 characters a second (relaxed)</option><option value="17" selected>17 characters a second</option><option value="20">20 characters a second</option><option value="25">25 characters a second (quick)</option></select>
        </label>
        <label>Longest row
          <select id="rLen"><option value="32">32 characters</option><option value="37">37 characters</option><option value="42" selected>42 characters</option><option value="47">47 characters</option></select>
        </label>
      </div>
      <label class="check"><input type="checkbox" id="rWrap" checked /> Rewrap long lines into at most two even rows</label>
      <label class="check"><input type="checkbox" id="rTime" checked /> Give fast lines more time, where the next line allows</label>
      <p class="hint" id="readReport"></p>
      <ol class="slow" id="slowList"></ol>
    </div>

    <div class="panel stack" data-panel="replace">
      <div class="rules" id="rules">
        <div class="rule"><label>Find <input data-find spellcheck="false" autocomplete="off" /></label><label>Replace with <input data-repl spellcheck="false" autocomplete="off" /></label></div>
      </div>
      <button type="button" class="link" id="addRule">Add another</button>
      <div class="optrow checks-row">
        <label class="check"><input type="checkbox" id="rCase" /> Match case</label>
        <label class="check"><input type="checkbox" id="rWord" checked /> Whole words only</label>
        <label class="check"><input type="checkbox" id="rRegex" /> Use patterns (regular expressions)</label>
      </div>
      <p class="hint" id="replReport">Leave "Replace with" empty to delete what you find. Every loaded file gets the same changes.</p>
    </div>

    <div class="panel stack" data-panel="edit">
      <div id="checks" class="checks" aria-live="polite"></div>
      <label class="check"><input type="checkbox" id="onlyIssues" /> Only lines with problems</label>
      <div class="editor" id="editor"></div>
      <div class="edit-actions">
        <button type="button" class="link" id="moreRows" hidden>Show more lines</button>
        <button type="button" class="link" id="addEnd">Add a line at the end</button>
      </div>
    </div>

    <div class="panel" data-panel="convert">
      <p class="hint">Pick the output format below. Timing and text are kept. Italics and bold carry over where the format allows.</p>
    </div>

    <div class="panel stack" data-panel="merge">
      <div class="mkind" role="radiogroup" aria-label="How to merge">
        <label class="check"><input type="radio" name="mkind" value="stack" checked={preset.merge !== 'parts'} /> Two languages on screen together</label>
        <label class="check"><input type="radio" name="mkind" value="parts" checked={preset.merge === 'parts'} /> Parts one after another, like CD1 and CD2</label>
      </div>
      <div class="syncrow" id="mStack">
        <label>First language <select id="mA"></select></label>
        <label>Second language <select id="mB"></select></label>
        <label class="check"><input type="checkbox" id="mTop" /> Put the second language at the top of the screen</label>
      </div>
      <div class="mparts" id="mParts" hidden></div>
      <p class="hint" id="mHint"></p>
    </div>

    </div>

    <div class="outrow">
      <label>Save as
        <select id="outFmt">
          <optgroup label="Subtitles">
            <option value="srt">SRT</option>
            <option value="vtt">VTT</option>
            <option value="ass">ASS</option>
            <option value="ssa">SSA</option>
            <option value="sbv">SBV</option>
            <option value="sub">MicroDVD (.sub)</option>
            <option value="smi">SAMI (.smi)</option>
            <option value="ttml">TTML</option>
            <option value="dfxp">DFXP</option>
          </optgroup>
          <optgroup label="Text and documents">
            {DOC_FORMATS.map((d) => <option value={d.value}>{d.label}</option>)}
          </optgroup>
        </select>
      </label>
      <label id="numWrap">Number from
        <input id="firstNum" value="1" inputmode="numeric" size="6" />
      </label>
      <label id="outFpsWrap" hidden>At
        <select id="outFps">{fps.map((f) => <option value={f.v} selected={f.l === '23.976'}>{f.l} fps</option>)}</select>
      </label>
      <button type="button" class="primary" id="download">Download fixed file</button>
    </div>
    <p class="hint batchnote" id="batchNote" hidden></p>

    <p class="error" id="opError" hidden></p>

    <div class="preview" id="preview">
      <div class="pvhead">
        <p class="pvsum" id="pvSum" aria-live="polite"></p>
        <label class="check"><input type="checkbox" id="onlyChanged" checked /> Only lines that change</label>
      </div>
      <table>
        <thead><tr><th>#</th><th>Before</th><th>After</th><th>Text</th></tr></thead>
        <tbody id="rows"></tbody>
      </table>
    </div>
  </div>
</section>

<script>
  import {
    decode, parse, build, retime, retimeAssRaw, shiftFn, fpsFn, twoPointFn, fixCommon, validate, checkSrtRaw,
    encodingCandidates, garbleScore, fmtTime, parseTime, stripTags, ENCODINGS, LANG_ENCODINGS, REPAIR_UTF8, FORMAT_LABEL,
    type Doc, type OutFormat, type Caption, type TimeFn, type Candidate,
  } from '../lib/subs';
  import { DOC_FORMATS, isDocFormat, exportDoc, zipFiles, type DocFormat } from '../lib/export';
  import { isEbuStl, parseEbuStl, mergeStack, mergeTop, mergeParts, autoOffsets } from '../lib/formats';
  import { isSup, isVobSub, parseSup, type SupImage } from '../lib/sup';
  import { fixTiming, reflow, compileRules, findReplace, cps, longestLine } from '../lib/tidy';

  type Entry = { name: string; buf: ArrayBuffer; doc: Doc | null; encoding: string; forced: string; edited: boolean; error: string; cands?: Candidate[]; track?: string; sup?: SupImage[]; ocrLang?: string };

  const root = document.getElementById('tool')!;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const fileInput = $<HTMLInputElement>('file');
  const drop = $('drop');
  const encSel = $<HTMLSelectElement>('enc');
  const outFmt = $<HTMLSelectElement>('outFmt');
  for (const e of [...ENCODINGS, REPAIR_UTF8]) encSel.add(new Option(e, e));

  const BATCH_MODES = new Set(['shift', 'fps', 'timing', 'encoding', 'clean', 'reading', 'replace', 'convert']);
  /** Modes that change more than the times, so ASS files are rebuilt instead of retimed in place. */
  const REBUILD = new Set(['clean', 'merge', 'timing', 'reading', 'replace']);
  const SUB_FORMATS = ['srt', 'vtt', 'ass', 'ssa', 'sbv', 'sub', 'smi', 'ttml', 'dfxp'];
  const EDITOR_PAGE = 200;

  let mode = root.dataset.mode as string;
  let files: Entry[] = [];
  let cur = 0;
  let mergeOffsets: number[] | null = null;
  let editorLimit = EDITOR_PAGE;
  const entry = () => files[cur];
  const doc = () => files[cur]?.doc ?? null;
  const n = (k: number, word: string, plural = word + 's') => `${k} ${k === 1 ? word : plural}`;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const okFiles = () => files.filter((f) => f.doc);

  // ---------- tabs and symptoms ----------

  const GROUP_OF: Record<string, string> = { shift: 'timing', fps: 'timing', sync: 'timing', timing: 'timing', encoding: 'text', clean: 'text', reading: 'text', replace: 'text', edit: 'text', convert: 'convert', merge: 'convert' };
  function setTab(id: string) {
    mode = id;
    root.dataset.group = GROUP_OF[id] ?? 'timing';
    const tab = root.querySelector<HTMLElement>(`[data-tab="${id}"]`);
    if (root.querySelector('input[name="sym"]:checked')) $('dropFix').textContent = `Fix: ${tab?.textContent ?? ''}`;
    root.querySelectorAll<HTMLElement>('[data-tab]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === id)));
    root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== id));
    $('preview').hidden = id === 'edit';
    if (id === 'edit') renderEditor();
    if (id === 'encoding') renderCands();
    if (id === 'merge' && files.length) renderMerge();
    render();
  }
  root.querySelectorAll<HTMLElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => setTab(b.dataset.tab!)));
  root.querySelectorAll<HTMLInputElement>('input[name="sym"]').forEach((r) =>
    r.addEventListener('change', () => {
      if (r.checked) setTab(r.dataset.go!);
    }),
  );
  // Links elsewhere on the page ("which fix do I need") open a tab in place.
  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-go-tab]');
    if (!t) return;
    e.preventDefault();
    const id = t.dataset.goTab!;
    const r = root.querySelector<HTMLInputElement>(`input[name="sym"][value="${t.dataset.sym ?? ''}"]`) ?? root.querySelector<HTMLInputElement>(`input[name="sym"][data-go="${id}"]`);
    if (r) r.checked = true;
    setTab(id);
    root.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  setTab(mode);

  // ---------- loading ----------

  function txtOpts() {
    const start = parseTime($<HTMLInputElement>('txtStart').value);
    return { cps: +$<HTMLSelectElement>('txtCps').value || 15, startMs: isNaN(start) ? 0 : start };
  }

  // ---------- picture subtitles (.sup) ----------

  const LANG_HINT: Record<string, string> = {
    en: 'eng', eng: 'eng', english: 'eng', es: 'spa', spa: 'spa', spanish: 'spa', fr: 'fra', fre: 'fra', fra: 'fra', french: 'fra',
    de: 'deu', ger: 'deu', deu: 'deu', german: 'deu', it: 'ita', ita: 'ita', italian: 'ita', pt: 'por', por: 'por', nl: 'nld', dut: 'nld', nld: 'nld',
    sv: 'swe', swe: 'swe', da: 'dan', dan: 'dan', no: 'nor', nor: 'nor', fi: 'fin', fin: 'fin', pl: 'pol', pol: 'pol', cs: 'ces', cze: 'ces', ces: 'ces',
    hu: 'hun', hun: 'hun', ro: 'ron', rum: 'ron', ron: 'ron', tr: 'tur', tur: 'tur', el: 'ell', gre: 'ell', ell: 'ell', ru: 'rus', rus: 'rus',
    uk: 'ukr', ukr: 'ukr', he: 'heb', heb: 'heb', ar: 'ara', ara: 'ara', zh: 'chi_sim', chi: 'chi_sim', zho: 'chi_sim', ja: 'jpn', jpn: 'jpn', ko: 'kor', kor: 'kor',
  };
  /** movie.fre.sup or Show [German].sup: take the language from the last words of the name. */
  const guessLang = (name: string) =>
    name.toLowerCase().replace(/\.[^.]+$/, '').split(/[._\-\s\[\]()]+/).filter(Boolean).slice(-2).reverse().map((t) => LANG_HINT[t]).find(Boolean) ?? $<HTMLSelectElement>('ocrLang').value;
  let ocrAbort: AbortController | null = null;

  async function readSup(f: Entry, bytes: Uint8Array) {
    f.sup ??= parseSup(bytes);
    if (!f.sup.length) throw new Error('No subtitle pictures were found in this file.');
    const lang = (f.ocrLang ??= guessLang(f.name));
    const box = $('ocr'), msg = $('ocrMsg'), bar = $<HTMLProgressElement>('ocrBar');
    ocrAbort = new AbortController();
    box.hidden = false;
    try {
      const { ocrImages } = await import('../lib/ocr');
      const caps = await ocrImages(f.sup, lang, (d, t, stage) => {
        bar.max = t;
        bar.value = d;
        msg.textContent = stage === 'load' ? `Getting the text reader ready for ${f.name}. The first time, this downloads a few MB.` : `Reading ${f.name}: ${d} of ${t} pictures`;
      }, ocrAbort.signal);
      if (!caps.length) throw new Error('No text could be read from the pictures in this file.');
      f.doc = { format: 'sup', captions: caps, raw: '' };
      f.encoding = 'OCR';
      f.error = '';
      f.edited = false;
    } finally {
      box.hidden = true;
      ocrAbort = null;
    }
  }

  async function loadEntry(f: Entry, forced = '') {
    f.forced = forced;
    try {
      const bytes = new Uint8Array(f.buf);
      if (isVobSub(bytes)) throw new Error('This .sub file holds DVD pictures (it comes with an .idx file). Only Blu-ray .sup picture files can be read here.');
      if (isSup(bytes)) return await readSup(f, bytes);
      if (isEbuStl(bytes)) {
        const r = parseEbuStl(bytes);
        if (!r.captions.length) throw new Error('No subtitle lines were found in this file.');
        f.doc = { format: 'stl', captions: r.captions, raw: '', fps: r.fps, frames: 'header' };
        f.encoding = 'EBU STL';
        f.error = '';
        f.edited = false;
        return;
      }
      let { text, encoding } = await decode(f.buf, forced || undefined);
      // jschardet can be unsure on short files. If another code page reads clearly better, use it.
      if (!forced && !/^utf/i.test(encoding)) {
        const best = encodingCandidates(f.buf, ENCODINGS)[0];
        if (best && best.score < garbleScore(text)) ({ text, encoding } = best);
      }
      const srcFps = parseFloat($<HTMLSelectElement>('srcFps').value) || 24000 / 1001;
      f.doc = parse(text, srcFps, { name: f.name, track: f.track, txt: txtOpts() });
      f.track = f.doc.track;
      f.encoding = encoding;
      f.error = '';
      f.edited = false;
    } catch (e: any) {
      f.doc = null;
      f.error = e?.message ?? String(e);
    }
  }

  async function takeFiles(list: FileList | File[], append = false) {
    const err = append ? $('opError') : $('loadError');
    err.hidden = true;
    const all = [...list];
    if (!all.length) return;
    const msgs: string[] = [];
    const room = append ? 100 - files.length : 100;
    if (all.length > room) msgs.push(room > 0 ? `Only ${room} more files fit. The limit is 100.` : 'The limit is 100 files.');
    const next: Entry[] = [];
    for (const f of all.slice(0, Math.max(0, room))) {
      const cap = /\.sup$/i.test(f.name) ? 100 : 20;
      if (f.size > cap * 1024 * 1024) {
        msgs.push(`${f.name} is over ${cap} MB, which is far bigger than a subtitle file should be.`);
        continue;
      }
      const e: Entry = { name: f.name, buf: await f.arrayBuffer(), doc: null, encoding: '', forced: '', edited: false, error: '' };
      await loadEntry(e);
      if (!e.doc) msgs.push(`${f.name}: ${e.error}`);
      next.push(e);
    }
    if (!next.some((f) => f.doc)) {
      err.textContent = msgs.join(' ') || "This doesn't look like a subtitle file we can read.";
      err.hidden = false;
      return;
    }
    if (next.some((f) => f.doc?.format === 'sup')) msgs.push('Lines from .sup files were read from pictures. Expect a few wrong letters, so look them over in "Check and edit".');
    const note = $('fileNote');
    note.textContent = msgs.join(' ');
    note.hidden = !msgs.length;
    mergeOffsets = null;
    if (append) {
      files = files.concat(next.filter((f) => f.doc));
      if (mode === 'merge') renderMerge();
      showFile();
      return;
    }
    files = next.filter((f) => f.doc);
    cur = 0;
    const preset = root.dataset.out;
    const d = files[0].doc!;
    outFmt.value = preset || (SUB_FORMATS.includes(d.format) ? d.format : 'srt');
    $<HTMLSelectElement>('outFps').value = nearestFps(d.fps);
    if (mode === 'merge') renderMerge();
    showFile();
    $('pick').hidden = true;
    root.classList.add('has-file');
    $('loaded').hidden = false;
  }

  function showFile() {
    const f = entry();
    const d = f.doc!;
    const many = files.length > 1;
    $('fname').hidden = many;
    $('fname').textContent = f.name;
    $('filePickWrap').hidden = !many;
    if (many) {
      const pick = $<HTMLSelectElement>('filePick');
      if (pick.options.length !== files.length) {
        pick.innerHTML = '';
        files.forEach((x, i) => pick.add(new Option(x.name, String(i))));
      }
      pick.value = String(cur);
      $('fileCount').textContent = `${files.length} files, showing`;
    }
    const c = d.captions;
    $('fmeta').textContent = `${FORMAT_LABEL[d.format] ?? d.format} · ${n(c.length, 'line')} · ${fmtTime(c[0].start)} → ${fmtTime(c[c.length - 1].end)} · ${f.encoding === 'OCR' ? 'read with OCR' : `read as ${f.encoding}`}`;
    encSel.value = f.forced;
    encSel.disabled = d.format === 'stl' || d.format === 'sup';
    encSel.closest('label')!.hidden = encSel.disabled;
    showSrcOpts(d);
    f.cands = undefined;
    fillLineSelects();
    editorLimit = EDITOR_PAGE;
    if (mode === 'edit') renderEditor();
    if (mode === 'encoding') renderCands();
    render();
  }

  const FPS_VALUES = () => [...$<HTMLSelectElement>('srcFps').options].map((o) => o.value);
  function nearestFps(f?: number) {
    const vals = FPS_VALUES();
    if (!f) return vals[0];
    return vals.reduce((a, b) => (Math.abs(+b - f) < Math.abs(+a - f) ? b : a));
  }

  /** Options that change how the file itself is read: frame rate, language, reading speed. */
  function showSrcOpts(d: Doc) {
    const guess = d.frames === 'guess';
    const many = (d.tracks?.length ?? 0) > 1;
    const speed = d.txt === 'speed';
    const ocr = d.format === 'sup';
    $('ocrLangWrap').hidden = !ocr;
    if (ocr) $<HTMLSelectElement>('ocrLang').value = entry().ocrLang ?? 'eng';
    $('srcFpsWrap').hidden = !guess;
    $('trackWrap').hidden = !many;
    $('txtCpsWrap').hidden = $('txtStartWrap').hidden = !speed;
    $('srcOpts').hidden = !(guess || many || speed || ocr);
    if (many) {
      const t = $<HTMLSelectElement>('track');
      t.innerHTML = '';
      d.tracks!.forEach((x) => t.add(new Option(x.label, x.id)));
      t.value = d.track ?? '';
    }
    $('srcHint').textContent = ocr
      ? 'Read with OCR. If the words look wrong, pick the language of the text and it reads them again.'
      : guess
      ? 'The file has no frame rate inside it. If every line is off by more and more, try another rate here.'
      : speed
        ? 'This text has no times, so each line gets time to read it. Shift or sync afterwards to line it up with the video.'
        : many
          ? `This file holds ${d.tracks!.length} languages. Pick the one you want.`
          : '';
  }

  async function reparse(all: boolean) {
    for (const f of all ? okFiles() : [entry()]) await loadEntry(f, f.forced);
    mergeOffsets = null;
    if (mode === 'merge') renderMerge();
    showFile();
  }

  function fillLineSelects() {
    const d = doc();
    if (!d) return;
    const l1 = $<HTMLSelectElement>('l1');
    const l2 = $<HTMLSelectElement>('l2');
    const fl = $<HTMLSelectElement>('fromLine');
    const keep = fl.value;
    l1.innerHTML = l2.innerHTML = fl.innerHTML = '';
    fl.add(new Option('Line 1 (shift every line)', '0'));
    d.captions.forEach((c, i) => {
      const label = `${i + 1}. ${fmtTime(c.start)}  ${stripTags(c.text).replace(/\n/g, ' ').slice(0, 40)}`;
      l1.add(new Option(label, String(i)));
      l2.add(new Option(label, String(i)));
      if (i) fl.add(new Option(label, String(i)));
    });
    l1.value = '0';
    l2.value = String(d.captions.length - 1);
    fl.value = keep && +keep < d.captions.length ? keep : '0';
    $<HTMLInputElement>('t1').value = fmtTime(d.captions[0].start);
    $<HTMLInputElement>('t2').value = fmtTime(d.captions[d.captions.length - 1].start);
  }

  // ---------- computing ----------

  function timeFn(d: Doc): TimeFn | null {
    if (mode === 'shift') {
      const raw = $<HTMLInputElement>('offset').value.trim();
      const ms = /^-?\d+(\.\d+)?$/.test(raw) ? Math.round(parseFloat(raw) * 1000) : parseTime(raw);
      if (isNaN(ms)) throw new Error('Enter the offset in seconds (like 2.5 or -1) or as a time (00:00:02,500).');
      return shiftFn(ms);
    }
    if (mode === 'fps') {
      const a = parseFloat($<HTMLSelectElement>('fpsFrom').value);
      const b = parseFloat($<HTMLSelectElement>('fpsTo').value);
      const pct = ((a / b - 1) * 100).toFixed(2);
      $('fpsHint').textContent = a === b ? 'Same frame rate, nothing will change.' : `Every time is multiplied by ${(a / b).toFixed(5)} (${+pct > 0 ? '+' : ''}${pct}%).`;
      return fpsFn(a, b);
    }
    if (mode === 'sync') {
      const i1 = +$<HTMLSelectElement>('l1').value;
      const i2 = +$<HTMLSelectElement>('l2').value;
      const t1 = parseTime($<HTMLInputElement>('t1').value);
      const t2 = parseTime($<HTMLInputElement>('t2').value);
      if (isNaN(t1) || isNaN(t2)) throw new Error('Type both target times, like 00:01:23,400.');
      if (i1 === i2) throw new Error('Pick two different lines.');
      return twoPointFn(d.captions[i1].start, t1, d.captions[i2].start, t2);
    }
    return null;
  }

  /** Shift from a chosen line: the time of that line in the file on screen, applied to every file. */
  function fromMs(): number {
    if (mode !== 'shift') return -Infinity;
    const i = +$<HTMLSelectElement>('fromLine').value;
    return i > 0 ? doc()!.captions[i]?.start ?? -Infinity : -Infinity;
  }

  function cleanOpts() {
    const on = (id: string) => $<HTMLInputElement>(id).checked;
    return {
      removeBrackets: on('brackets'), removeSpeakers: on('speakers'), removeMusic: on('music'), removeTags: on('tags'),
      removeDuplicates: on('dupes'), fixOverlaps: on('overlaps'), minDurationMs: on('mindur') ? 700 : 0,
    };
  }

  function timingOpts() {
    return {
      fixOverlaps: $<HTMLInputElement>('tOverlap').checked, minGapMs: +$<HTMLSelectElement>('tGap').value,
      minDurMs: +$<HTMLSelectElement>('tMin').value, maxDurMs: +$<HTMLSelectElement>('tMax').value,
      cps: $<HTMLInputElement>('tRead').checked ? +$<HTMLSelectElement>('rCps').value : 0,
    };
  }
  function replaceRules() {
    const rules = [...document.querySelectorAll<HTMLElement>('#rules .rule')].map((r) => ({
      find: r.querySelector<HTMLInputElement>('[data-find]')!.value, replace: r.querySelector<HTMLInputElement>('[data-repl]')!.value,
    }));
    return compileRules(rules, { regex: $<HTMLInputElement>('rRegex').checked, matchCase: $<HTMLInputElement>('rCase').checked, wholeWord: $<HTMLInputElement>('rWord').checked });
  }
  const firstNum = () => Math.max(0, Math.floor(+$<HTMLInputElement>('firstNum').value) || 1);
  const sec = (ms: number) => `${(ms / 1000).toFixed(1).replace(/\.0$/, '')} s`;
  const sentence = (parts: string[], none: string) => (parts.length ? (parts.join(' · ') + '.').replace(/^./, (c) => c.toUpperCase()) : none);

  function compute(f: Entry, report = false): { caps: Caption[]; text: string | null } {
    const d = f.doc!;
    const fmt = outFmt.value;
    const fn = timeFn(d);
    const from = fromMs();
    // Each line carries its original index (_i) so the preview can pair it with its before.
    let caps: Caption[] = mode === 'merge' ? mergeCaps() : d.captions.map((c, i) => ({ ...c, _i: i }) as Caption);
    if (fn) caps = retime(caps, fn, from);
    if (mode === 'clean') {
      const { captions, report: r } = fixCommon(caps, cleanOpts());
      caps = captions;
      if (report) {
        const parts = [];
        if (r.hiRemoved) parts.push(`text removed from ${n(r.hiRemoved, 'line')}`);
        if (r.removedEmpty) parts.push(`${n(r.removedEmpty, 'empty line')} deleted`);
        if (r.merged) parts.push(`${n(r.merged, 'repeated line')} merged`);
        if (r.fixedOverlaps) parts.push(`${n(r.fixedOverlaps, 'overlap')} fixed`);
        if (r.extended) parts.push(`${n(r.extended, 'short line')} lengthened`);
        if (r.sorted) parts.push('lines put back in time order');
        $('cleanReport').textContent = parts.length ? (parts.join(' · ') + '.').replace(/^./, (c) => c.toUpperCase()) : 'Nothing needed fixing with these options.';
      }
    }
    if (mode === 'timing') {
      const { captions, report: r } = fixTiming(caps, timingOpts());
      caps = captions;
      if (report) {
        const parts = [];
        if (r.overlaps) parts.push(`${n(r.overlaps, 'overlap')} fixed`);
        if (r.gaps) parts.push(`${n(r.gaps, 'gap')} opened up`);
        if (r.lengthened) parts.push(`${n(r.lengthened, 'line')} kept up longer`);
        if (r.shortened) parts.push(`${n(r.shortened, 'line')} cut shorter`);
        if (r.sorted) parts.push('lines put back in time order');
        $('timingReport').textContent = sentence(parts, 'The timing already fits these settings.');
      }
    }
    if (mode === 'reading') {
      const limit = +$<HTMLSelectElement>('rCps').value, len = +$<HTMLSelectElement>('rLen').value;
      const fastBefore = caps.filter((c) => cps(c) > limit).length;
      const longBefore = caps.filter((c) => longestLine(c.text) > len).length;
      let wrapped = 0;
      if ($<HTMLInputElement>('rWrap').checked) ({ captions: caps, changed: wrapped } = reflow(caps, len));
      if ($<HTMLInputElement>('rTime').checked) caps = fixTiming(caps, { fixOverlaps: false, minGapMs: 0, minDurMs: 0, maxDurMs: 0, cps: limit }).captions;
      if (report) {
        const slow = caps.map((c, i) => ({ c, i, v: cps(c) })).filter((x) => x.v > limit);
        const long = caps.filter((c) => longestLine(c.text) > len).length;
        const parts = [`${n(fastBefore, 'line')} faster than ${limit} characters a second`, `${n(longBefore, 'line')} with a row over ${len} characters`];
        let after = '';
        if (wrapped) after += ` ${n(wrapped, 'line')} rewrapped.`;
        if (slow.length !== fastBefore || long !== longBefore) after += ` After the fix: ${slow.length} too fast, ${long} too long.`;
        if (slow.length) after += slow.length === fastBefore ? '' : ' The rest have no room before the next line, so shorten their words in "Check and edit".';
        $('readReport').textContent = `Before: ${parts.join(', ')}.${after}`;
        $('slowList').innerHTML = slow.sort((a, b) => b.v - a.v).slice(0, 6).map((x) =>
          `<li><span class="mono">${x.v.toFixed(0)}/s</span> <span class="mono">${fmtTime(x.c.start)}</span> ${esc(stripTags(x.c.text).replace(/\n/g, ' '))}</li>`).join('');
      }
    }
    if (mode === 'replace') {
      const rules = replaceRules();
      const r = findReplace(caps, rules);
      caps = r.captions;
      if (report)
        $('replReport').textContent = !rules.length
          ? 'Type what to find. Leave "Replace with" empty to delete it. Every loaded file gets the same changes.'
          : r.hits
            ? `${n(r.hits, 'match', 'matches')} in ${n(r.lines, 'line')} of this file.${r.emptied ? ` ${n(r.emptied, 'line')} left empty will be deleted.` : ''}`
            : 'No matches in this file.';
    }
    if (isDocFormat(fmt)) return { caps, text: null };
    const ass = d.format === 'ass' || d.format === 'ssa';
    // Same ASS/SSA format and a timing-only change: rewrite in place so styling survives.
    if (ass && fmt === d.format && !REBUILD.has(mode) && !f.edited) return { caps, text: fn ? retimeAssRaw(d.raw, fn, from) : d.raw };
    // Only the characters were wrong: keep the file exactly as it was, now in UTF-8.
    if (mode === 'encoding' && fmt === d.format && !f.edited) return { caps, text: d.raw };
    return { caps, text: build(caps, fmt as OutFormat, parseFloat($<HTMLSelectElement>('outFps').value), firstNum()) };
  }

  function render() {
    const d = doc();
    if (!d) return;
    updateBatchNote();
    const err = $('opError');
    try {
      const { caps } = compute(entry(), true);
      err.hidden = true;
      drawMap(d.captions, caps);
      if (mode === 'edit') return;
      $('outFpsWrap').hidden = outFmt.value !== 'sub';
      $('numWrap').hidden = outFmt.value !== 'srt';
      renderPreview(d.captions, caps);
    } catch (e: any) {
      $('rows').innerHTML = '';
      err.textContent = e?.message ?? String(e);
      err.hidden = false;
    }
  }

  // ---------- before and after table ----------

  const PREVIEW_ROWS = 60;
  function renderPreview(before: Caption[], caps: Caption[]) {
    const plainOut = isDocFormat(outFmt.value) || outFmt.value === 'sbv' || outFmt.value === 'sub';
    const show = (t: string) => (plainOut ? esc(stripTags(t)) : esc(t)).replace(/\n/g, '<br>');
    type Row = { i: number; b?: Caption; a?: Caption; changed: boolean };
    let items: Row[];
    if (mode === 'merge') {
      items = caps.map((a, i) => ({ i, a, changed: false }));
    } else {
      const seen = new Set<number>();
      items = caps.map((a) => {
        const i = (a as any)._i as number;
        seen.add(i);
        const b = before[i];
        return { i, b, a, changed: !b || a.start !== b.start || a.end !== b.end || a.text !== b.text };
      });
      before.forEach((b, i) => { if (!seen.has(i)) items.push({ i, b, changed: true }); });
      items.sort((x, y) => x.i - y.i || (x.a?.start ?? 0) - (y.a?.start ?? 0));
    }
    const changed = items.filter((x) => x.changed);
    const only = $<HTMLInputElement>('onlyChanged').checked && changed.length > 0;
    const list = (only ? changed : items).slice(0, PREVIEW_ROWS);
    $('onlyChanged').closest('label')!.hidden = mode === 'merge' || !changed.length;
    const removed = items.filter((x) => !x.a).length;
    $('pvSum').textContent =
      mode === 'merge' ? `${n(caps.length, 'line')} in the merged file.`
      : changed.length ? `${changed.length} of ${n(before.length, 'line')} change${removed ? ` (${removed} removed)` : ''}.${(only ? changed : items).length > PREVIEW_ROWS ? ` Showing the first ${PREVIEW_ROWS}.` : ''}`
      : `No line changes${outFmt.value !== doc()?.format ? ', only the format' : ''}.`;
    $('rows').innerHTML = list.map(({ i, b, a, changed: ch }) => {
      const t0 = b ? fmtTime(b.start) : '';
      if (!a) return `<tr class="gone"><td>${i + 1}</td><td>${t0}</td><td>removed</td><td><del>${show(b!.text)}</del></td></tr>`;
      const moved = b && a.start !== b.start;
      const text = b && a.text !== b.text ? `<del>${show(b.text)}</del><ins>${show(a.text)}</ins>` : show(a.text);
      return `<tr${ch ? ' class="ch"' : ''}><td>${i + 1}</td><td>${t0}</td><td${moved ? ' class="moved"' : ''}>${fmtTime(a.start)}</td><td>${text}</td></tr>`;
    }).join('');
  }

  // ---------- cue map: every line as a block on one timeline, before above, after below ----------

  const map = $<SVGSVGElement & HTMLElement>('cuemap');
  const W = 1000, H = 60;
  map.setAttribute('viewBox', `0 0 ${W} ${H}`);
  let mapAfter: Caption[] = [];
  let mapT0 = 0, mapT1 = 1, headIdx = 0;
  const bars = (caps: Caption[], y: number, h: number) => {
    const k = W / (mapT1 - mapT0);
    let p = '';
    for (const c of caps) {
      const x = (c.start - mapT0) * k;
      const w = Math.max(1.2, (c.end - c.start) * k);
      p += `M${x.toFixed(1)} ${y}h${w.toFixed(1)}v${h}h${(-w).toFixed(1)}z`;
    }
    return p;
  };
  function drawMap(before: Caption[], after: Caption[]) {
    if (!before.length && !after.length) return;
    const all = before.concat(after);
    mapT0 = Math.min(...all.map((c) => c.start));
    mapT1 = Math.max(mapT0 + 1, ...all.map((c) => c.end));
    mapAfter = after;
    $('cmBefore').setAttribute('d', bars(before, 6, 18));
    $('cmAfter').setAttribute('d', bars(after, 34, 18));
    const over = after.filter((c, i) => i > 0 && c.start < after[i - 1].end);
    $('cmIssue').setAttribute('d', bars(over, 34, 18));
    map.setAttribute('aria-valuemax', String(Math.max(0, after.length - 1)));
    setHead(Math.min(headIdx, after.length - 1), false);
    if (videoOn()) videoTick();
  }
  function setHead(i: number, seek = true) {
    if (!mapAfter.length) return;
    headIdx = Math.max(0, Math.min(mapAfter.length - 1, i));
    const c = mapAfter[headIdx];
    const x = ((c.start - mapT0) * W) / (mapT1 - mapT0);
    $('cmHead').setAttribute('d', `M${x.toFixed(1)} 0V${H}`);
    $('vsub').textContent = stripTags(c.text);
    $('vtime').textContent = `Line ${headIdx + 1} of ${mapAfter.length} · ${fmtTime(c.start)}`;
    map.setAttribute('aria-valuenow', String(headIdx));
    map.setAttribute('aria-valuetext', `Line ${headIdx + 1}, ${fmtTime(c.start)}`);
    if (videoOn() && seek) video.currentTime = c.start / 1000;
  }
  const headAt = (clientX: number) => {
    const r = map.getBoundingClientRect();
    const t = mapT0 + ((clientX - r.left) / r.width) * (mapT1 - mapT0);
    let best = 0;
    mapAfter.forEach((c, i) => { if (Math.abs(c.start - t) < Math.abs(mapAfter[best].start - t)) best = i; });
    setHead(best);
  };
  map.addEventListener('pointerdown', (e) => {
    headAt(e.clientX);
    map.setPointerCapture(e.pointerId);
    const move = (ev: PointerEvent) => headAt(ev.clientX);
    map.addEventListener('pointermove', move);
    map.addEventListener('pointerup', () => map.removeEventListener('pointermove', move), { once: true });
  });
  map.addEventListener('keydown', (e) => {
    const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1, PageDown: 10, PageUp: -10 }[e.key];
    if (step) { e.preventDefault(); setHead(headIdx + step); }
    else if (e.key === 'Home') { e.preventDefault(); setHead(0); }
    else if (e.key === 'End') { e.preventDefault(); setHead(mapAfter.length - 1); }
  });

  // ---------- merge ----------

  const mkind = () => root.querySelector<HTMLInputElement>('input[name="mkind"]:checked')?.value ?? 'stack';
  const partOrder = () => [...okFiles()].sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true }));

  function renderMerge() {
    const ok = okFiles();
    const parts = mkind() === 'parts';
    $('mStack').hidden = parts;
    $('mParts').hidden = !parts;
    const a = $<HTMLSelectElement>('mA'), b = $<HTMLSelectElement>('mB');
    const ka = a.value, kb = b.value;
    a.innerHTML = b.innerHTML = '';
    ok.forEach((f, i) => { a.add(new Option(f.name, String(i))); b.add(new Option(f.name, String(i))); });
    a.value = ka && +ka < ok.length ? ka : '0';
    b.value = kb && +kb < ok.length ? kb : String(Math.min(1, ok.length - 1));
    if (a.value === b.value && ok.length > 1) b.value = a.value === '0' ? '1' : '0';
    const order = partOrder();
    mergeOffsets ??= autoOffsets(order.map((f) => f.doc!.captions));
    $('mParts').innerHTML = order
      .map((f, i) => `<div class="mpart"><span class="mname">Part ${i + 1}: ${esc(f.name)}</span><input data-part="${i}" value="${fmtTime(mergeOffsets![i])}" aria-label="Start part ${i + 1} at" spellcheck="false" /></div>`)
      .join('');
    $('mHint').textContent = ok.length < 2
      ? 'Merging needs two or more files. Use "Add files" at the top to load the next one.'
      : parts
        ? 'Each part starts at the time on its right. Parts that restart at zero are placed after the one before, so check the gap against your video.'
        : $<HTMLInputElement>('mTop').checked
          ? 'The second language gets a top-of-screen tag. SRT and ASS players honor it. VTT and the rest show both at the bottom.'
          : 'Where lines from both files are on screen together, they are stacked into one subtitle.';
  }

  function mergeCaps(): Caption[] {
    const ok = okFiles();
    if (ok.length < 2) return entry().doc!.captions; // the hint under the options asks for a second file
    if (mkind() === 'parts') {
      const order = partOrder();
      const offs = order.map((_, i) => {
        const el = $('mParts').querySelector<HTMLInputElement>(`[data-part="${i}"]`);
        const raw = el?.value.trim() ?? '';
        const ms = /^-?\d+(\.\d+)?$/.test(raw) ? Math.round(parseFloat(raw) * 1000) : parseTime(raw);
        if (isNaN(ms)) throw new Error(`Part ${i + 1}: type a start time like 00:52:10,000.`);
        return ms;
      });
      mergeOffsets = offs;
      return mergeParts(order.map((f) => f.doc!.captions), offs);
    }
    const a = ok[+$<HTMLSelectElement>('mA').value], b = ok[+$<HTMLSelectElement>('mB').value];
    if (!a || !b || a === b) throw new Error('Pick two different files.');
    return ($<HTMLInputElement>('mTop').checked ? mergeTop : mergeStack)(a.doc!.captions, b.doc!.captions);
  }
  root.querySelectorAll<HTMLInputElement>('input[name="mkind"]').forEach((r) => r.addEventListener('change', renderMerge));
  $('mTop').addEventListener('change', renderMerge);

  function targets(): Entry[] {
    return BATCH_MODES.has(mode) ? okFiles() : [entry()];
  }

  function updateBatchNote() {
    const many = files.length > 1;
    const t = targets();
    $('download').textContent = mode === 'merge' ? 'Download merged file' : t.length > 1 ? `Download ${t.length} files as a zip` : 'Download fixed file';
    const note = $('batchNote');
    note.hidden = !many;
    if (!many) return;
    note.textContent = mode === 'merge'
      ? `The files are combined into one download. The map above shows ${entry().name} before and the merged file after.`
      : BATCH_MODES.has(mode)
      ? `These settings apply to all ${files.length} files. The preview shows ${entry().name}.${mode === 'shift' && +$<HTMLSelectElement>('fromLine').value > 0 ? ' "Starting at line" uses that line’s time in every file.' : ''}`
      : `This fix works on one file at a time, so only ${entry().name} is downloaded.`;
  }

  function outName(f: Entry, fmt: string) {
    const base = f.name.replace(/\.[^.]+$/, '') + (mode === 'merge' ? '.merged' : '');
    const ext = isDocFormat(fmt) ? DOC_FORMATS.find((d) => d.value === fmt)!.ext : fmt;
    const srcExt = (f.name.match(/\.([^.]+)$/)?.[1] ?? '').toLowerCase();
    return srcExt === ext && mode !== 'merge' ? `${base}.fixed.${ext}` : `${base}.${ext}`;
  }

  async function produce(f: Entry): Promise<string | Uint8Array> {
    const fmt = outFmt.value;
    const { caps, text } = compute(f);
    if (text !== null) return text;
    return exportDoc(caps, fmt as DocFormat, f.name.replace(/\.[^.]+$/, ''));
  }

  function save(data: string | Uint8Array, name: string, type: string) {
    const blob = new Blob([data as BlobPart], { type });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = name;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 2000);
  }

  async function download() {
    const err = $('opError');
    const btn = $<HTMLButtonElement>('download');
    try {
      btn.disabled = true;
      const fmt = outFmt.value;
      const list = targets();
      if (list.length === 1) {
        const data = await produce(list[0]);
        const mime = isDocFormat(fmt) ? DOC_FORMATS.find((d) => d.value === fmt)!.mime : 'text/plain;charset=utf-8';
        save(data, outName(list[0], fmt), mime);
      } else {
        const out = [];
        for (const f of list) out.push({ name: outName(f, fmt), data: await produce(f) });
        save(await zipFiles(out), 'subtitles-fixed.zip', 'application/zip');
      }
      (window as any).plausible?.('download', { props: { mode, fmt, files: String(list.length) } });
    } catch (e: any) {
      err.textContent = e?.message ?? String(e);
      err.hidden = false;
    } finally {
      btn.disabled = false;
    }
  }

  // ---------- fix characters ----------

  function renderCands() {
    const f = entry();
    if (!f) return;
    const list = $('candList');
    if (f.doc?.format === 'sup') {
      list.innerHTML = '<p class="hint">This text was read from pictures, so there is no character set to fix. Wrong letters can be corrected in "Check and edit".</p>';
      return;
    }
    if (f.doc?.format === 'stl') {
      list.innerHTML = '<p class="hint">EBU STL files name their own character set, and this one was read with it. Nothing to pick here.</p>';
      return;
    }
    f.cands ??= encodingCandidates(f.buf, ENCODINGS);
    const li = $<HTMLSelectElement>('lang').value;
    let cands = f.cands;
    if (li !== '') {
      const encs = new Set(LANG_ENCODINGS[+li].encs.map((e) => e.toLowerCase()));
      cands = cands.filter((c) => encs.has(c.encoding.toLowerCase()) || /^utf-8/i.test(c.encoding));
    } else cands = cands.slice(0, 6);
    if (!f.cands.some((c) => c.sample.length)) {
      list.innerHTML = '<p class="hint">This file only uses plain English letters, so every encoding reads it the same way. Nothing to fix here.</p>';
      return;
    }
    const langOf = (e: string) => (e === REPAIR_UTF8 ? 'fixes text saved twice, like CafÃ©' : /^utf-8$/i.test(e) ? 'standard' : LANG_ENCODINGS.find((l) => l.encs.some((x) => x.toLowerCase() === e.toLowerCase()))?.lang.replace(/ \(.*/, '') ?? '');
    const current = (f.forced || f.encoding).toLowerCase();
    list.innerHTML = cands
      .map((c) => {
        const id = `cand-${c.encoding.replace(/\W/g, '')}`;
        return `<label class="cand" for="${id}"><input type="radio" name="cand" id="${id}" value="${esc(c.encoding)}"${c.encoding.toLowerCase() === current ? ' checked' : ''} />
          <span class="cand-name">${esc(c.encoding)}<span class="cand-lang">${esc(langOf(c.encoding))}</span></span>
          <span class="cand-sample">${c.sample.map(esc).join('<br>') || '<em>no accented letters</em>'}</span></label>`;
      })
      .join('');
  }
  $('candList').addEventListener('change', async (e) => {
    const r = e.target as HTMLInputElement;
    if (r.name !== 'cand') return;
    await loadEntry(entry(), r.value);
    const keep = entry().cands;
    showFile();
    entry().cands = keep;
    renderCands();
  });
  $('lang').addEventListener('change', renderCands);

  // ---------- check and edit ----------

  function renderChecks() {
    const f = entry();
    const d = f.doc!;
    const issues = validate(d.captions);
    const items: string[] = [];
    if (d.format === 'srt' && !f.edited) for (const r of checkSrtRaw(d.raw).slice(0, 30)) items.push(`Line ${r.line} of the file: ${esc(r.text)}`);
    const counts = new Map<string, number>();
    for (const i of issues) counts.set(i.text, (counts.get(i.text) ?? 0) + 1);
    for (const [t, k] of counts) items.push(`${esc(t)}: ${n(k, 'line')}`);
    if (!/^utf-?8$/i.test(f.encoding) && d.format !== 'stl' && d.format !== 'sup') items.push(`The file is ${esc(f.encoding)}, not UTF-8. Downloads are saved as UTF-8.`);
    $('checks').innerHTML = items.length
      ? `<p class="checks-head">${n(items.length, 'thing', 'things')} to look at</p><ul>${items.map((t) => `<li>${t}</li>`).join('')}</ul>`
      : '<p class="checks-head">No problems found.</p>';
    return issues;
  }

  function issueMap(issues = validate(doc()!.captions)) {
    const m = new Map<number, string[]>();
    for (const i of issues) m.set(i.index, [...(m.get(i.index) ?? []), i.text]);
    return m;
  }

  function renderEditor() {
    const d = doc();
    if (!d) return;
    const issues = issueMap(renderChecks());
    const only = $<HTMLInputElement>('onlyIssues').checked;
    const idx = d.captions.map((_, i) => i).filter((i) => !only || issues.has(i));
    const shown = idx.slice(0, editorLimit);
    $('editor').innerHTML = shown.length
      ? shown
          .map((i) => {
            const c = d.captions[i];
            const iss = issues.get(i);
            return `<div class="erow" data-i="${i}">
          <span class="enum">${i + 1}</span>
          <input class="etime" data-f="start" value="${fmtTime(c.start)}" aria-label="Start of line ${i + 1}" spellcheck="false" />
          <input class="etime" data-f="end" value="${fmtTime(c.end)}" aria-label="End of line ${i + 1}" spellcheck="false" />
          <span class="eact"><button type="button" class="link" data-act="add">Add below</button><button type="button" class="link" data-act="del">Delete</button></span>
          <textarea data-f="text" rows="${Math.max(1, c.text.split('\n').length)}" aria-label="Text of line ${i + 1}">${esc(c.text)}</textarea>
          <p class="eissue">${iss ? esc(iss.join('. ')) : ''}</p>
        </div>`;
          })
          .join('')
      : `<p class="hint">${only ? 'No lines with problems.' : 'No lines.'}</p>`;
    $('moreRows').hidden = idx.length <= editorLimit;
    $('moreRows').textContent = `Show more lines (${idx.length - Math.min(idx.length, editorLimit)} hidden)`;
  }

  function refreshIssues() {
    const issues = issueMap(renderChecks());
    $('editor').querySelectorAll<HTMLElement>('.erow').forEach((row) => {
      const iss = issues.get(+row.dataset.i!);
      row.querySelector('.eissue')!.textContent = iss ? iss.join('. ') : '';
    });
  }

  function edited() {
    const f = entry();
    f.edited = true;
    f.cands = undefined;
  }

  const editor = $('editor');
  editor.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement | HTMLTextAreaElement;
    const i = +(t.closest<HTMLElement>('.erow')?.dataset.i ?? -1);
    const c = doc()?.captions[i];
    if (!c) return;
    if (t.dataset.f === 'text') {
      c.text = t.value;
      (t as HTMLTextAreaElement).rows = Math.max(1, t.value.split('\n').length);
      edited();
    }
  });
  editor.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    const i = +(t.closest<HTMLElement>('.erow')?.dataset.i ?? -1);
    const c = doc()?.captions[i];
    if (!c) return;
    if (t.dataset.f === 'start' || t.dataset.f === 'end') {
      const ms = parseTime(t.value);
      t.setAttribute('aria-invalid', String(isNaN(ms)));
      if (isNaN(ms)) return;
      c[t.dataset.f] = ms;
      t.value = fmtTime(ms);
      edited();
    }
    refreshIssues();
  });
  editor.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-act]');
    if (!b) return;
    const d = doc()!;
    const i = +b.closest<HTMLElement>('.erow')!.dataset.i!;
    if (b.dataset.act === 'del') {
      if (d.captions.length === 1) return;
      d.captions.splice(i, 1);
    } else {
      const c = d.captions[i];
      const next = d.captions[i + 1];
      const start = c.end + 1;
      const end = next ? Math.max(start, Math.min(start + 2000, next.start - 1)) : start + 2000;
      d.captions.splice(i + 1, 0, { start, end, text: '' });
    }
    edited();
    fillLineSelects();
    renderEditor();
    const focusRow = editor.querySelector<HTMLElement>(`.erow[data-i="${b.dataset.act === 'del' ? Math.min(i, d.captions.length - 1) : i + 1}"] textarea`);
    focusRow?.focus();
  });
  $('addEnd').addEventListener('click', () => {
    const d = doc()!;
    const last = d.captions[d.captions.length - 1];
    d.captions.push({ start: last.end + 1, end: last.end + 2001, text: '' });
    edited();
    $<HTMLInputElement>('onlyIssues').checked = false;
    editorLimit = Math.max(editorLimit, d.captions.length);
    fillLineSelects();
    renderEditor();
    editor.querySelector<HTMLTextAreaElement>('.erow:last-child textarea')?.focus();
  });
  $('moreRows').addEventListener('click', () => {
    editorLimit += EDITOR_PAGE;
    renderEditor();
  });
  $('onlyIssues').addEventListener('change', () => {
    editorLimit = EDITOR_PAGE;
    renderEditor();
  });

  // ---------- wiring ----------

  fileInput.addEventListener('change', () => fileInput.files?.length && takeFiles(fileInput.files));
  ['dragenter', 'dragover'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.add('over'); }));
  ['dragleave', 'drop'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.remove('over'); }));
  // Accept drops anywhere on the page.
  window.addEventListener('dragover', (e) => e.preventDefault());
  window.addEventListener('drop', (e) => {
    e.preventDefault();
    const fl = e.dataTransfer?.files;
    if (fl?.length) takeFiles(fl);
  });

  $<HTMLInputElement>('addFile').addEventListener('change', async (e) => {
    const inp = e.target as HTMLInputElement;
    if (inp.files?.length) await takeFiles(inp.files, true);
    inp.value = '';
  });
  $('srcFps').addEventListener('change', () => reparse(true));
  $('ocrLang').addEventListener('change', () => {
    entry().ocrLang = $<HTMLSelectElement>('ocrLang').value;
    reparse(false);
  });
  $('ocrStop').addEventListener('click', () => ocrAbort?.abort());
  $('txtCps').addEventListener('change', () => reparse(true));
  $('txtStart').addEventListener('change', () => reparse(true));
  $('track').addEventListener('change', () => {
    entry().track = $<HTMLSelectElement>('track').value;
    reparse(false);
  });
  encSel.addEventListener('change', async () => {
    await loadEntry(entry(), encSel.value);
    showFile();
  });
  $('filePick').addEventListener('change', () => {
    cur = +$<HTMLSelectElement>('filePick').value;
    showFile();
  });
  $('reset').addEventListener('click', () => {
    files = [];
    fileInput.value = '';
    $<HTMLSelectElement>('filePick').innerHTML = '';
    $('loaded').hidden = true;
    $('fileNote').hidden = true;
    root.classList.remove('has-file');
    $('pick').hidden = false;
    mergeOffsets = null;
  });
  $('download').addEventListener('click', download);
  $('swap').addEventListener('click', () => {
    const a = $<HTMLSelectElement>('fpsFrom'), b = $<HTMLSelectElement>('fpsTo');
    [a.value, b.value] = [b.value, a.value];
    render();
  });
  root.querySelectorAll<HTMLElement>('[data-nudge]').forEach((b) =>
    b.addEventListener('click', () => {
      const o = $<HTMLInputElement>('offset');
      const cur = parseFloat(o.value) || 0;
      o.value = String(Math.round((cur + +b.dataset.nudge! / 1000) * 1000) / 1000);
      render();
    }),
  );
  // ---------- watch with your video: a local file, played here with the fixed subtitles on top ----------

  const video = $<HTMLVideoElement>('video');
  let videoUrl = '';
  const videoOn = () => !!videoUrl;
  function cueAt(t: number) {
    let lo = 0, hi = mapAfter.length - 1, hit = -1;
    while (lo <= hi) {
      const mid = (lo + hi) >> 1;
      if (mapAfter[mid].start <= t) { hit = mid; lo = mid + 1; } else hi = mid - 1;
    }
    // Lines can overlap, so look back a little for one still on screen.
    for (let k = hit; k >= 0 && k > hit - 4; k--) if (mapAfter[k].end > t) return k;
    return -1;
  }
  function videoTick() {
    if (!videoOn() || !mapAfter.length) return;
    const t = video.currentTime * 1000;
    const k = cueAt(t);
    $('vsub').textContent = k >= 0 ? stripTags(mapAfter[k].text) : '';
    const x = ((t - mapT0) * W) / (mapT1 - mapT0);
    $('cmHead').setAttribute('d', `M${Math.max(0, Math.min(W, x)).toFixed(1)} 0V${H}`);
    $('vtime').textContent = `${fmtTime(t)}${k >= 0 ? ` · line ${k + 1}` : ''}`;
    if (k >= 0) headIdx = k;
  }
  let raf = 0;
  const loop = () => { videoTick(); raf = video.paused ? 0 : requestAnimationFrame(loop); };
  video.addEventListener('play', () => { if (!raf) raf = requestAnimationFrame(loop); });
  video.addEventListener('seeked', videoTick);
  video.addEventListener('timeupdate', () => { if (!raf) videoTick(); });
  video.addEventListener('error', () => {
    const note = $('vNote');
    note.textContent = 'This browser cannot play that video. MP4 and WebM files work best. Some MKV and AVI files only play in a video player.';
    note.hidden = false;
  });
  video.addEventListener('loadeddata', () => { $('vNote').hidden = true; videoTick(); });
  function showOffset() {
    const raw = $<HTMLInputElement>('offset').value.trim();
    const v = parseFloat(raw) || 0;
    $('vOff').textContent = mode === 'shift' && v ? `Moved ${v > 0 ? '+' : ''}${v} s` : '';
  }
  $<HTMLInputElement>('videoFile').addEventListener('change', (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (!f) return;
    if (videoUrl) URL.revokeObjectURL(videoUrl);
    videoUrl = URL.createObjectURL(f);
    video.src = videoUrl;
    video.hidden = false;
    root.classList.add('has-video');
    $('vctl').hidden = false;
    $('vPick').firstChild!.textContent = 'Use another video';
    $('vPick').classList.remove('lead');
    showOffset();
    (e.target as HTMLInputElement).value = '';
  });
  $('vClose').addEventListener('click', () => {
    video.pause();
    video.removeAttribute('src');
    video.load();
    URL.revokeObjectURL(videoUrl);
    videoUrl = '';
    video.hidden = true;
    root.classList.remove('has-video');
    $('vctl').hidden = true;
    $('vNote').hidden = true;
    $('vPick').firstChild!.textContent = 'Watch with your video';
    setHead(headIdx, false);
  });
  root.querySelectorAll<HTMLElement>('[data-vnudge]').forEach((b) =>
    b.addEventListener('click', () => {
      if (mode !== 'shift') {
        const r = root.querySelector<HTMLInputElement>('input[name="sym"][value="early-late"]');
        if (r && root.querySelector('input[name="sym"]:checked')) r.checked = true;
        setTab('shift');
      }
      const o = $<HTMLInputElement>('offset');
      const v = parseFloat(o.value) || 0;
      o.value = String(Math.round((v + +b.dataset.vnudge! / 1000) * 1000) / 1000);
      render();
      showOffset();
      videoTick();
    }),
  );

  // ---------- find and replace rows ----------

  $('addRule').addEventListener('click', () => {
    const first = document.querySelector<HTMLElement>('#rules .rule')!;
    const row = first.cloneNode(true) as HTMLElement;
    row.querySelectorAll('input').forEach((i) => (i.value = ''));
    $('rules').append(row);
    row.querySelector('input')!.focus();
  });

  const quiet = new Set(['enc', 'file', 'filePick', 'lang', 'onlyIssues', 'addFile', 'srcFps', 'txtCps', 'txtStart', 'track', 'ocrLang', 'videoFile']);
  const inPanel = (el: HTMLElement) => el.closest('#editor, #candList, .pick');
  root.addEventListener('input', (e) => {
    const t = e.target as HTMLElement;
    if (!quiet.has(t.id) && !inPanel(t)) render();
  });
  root.addEventListener('change', (e) => {
    const t = e.target as HTMLElement;
    if (!quiet.has(t.id) && !inPanel(t)) render();
  });
</script>
