---
import Base from '../layouts/Base.astro';
import Tool from './Tool.astro';
import { SITE, GUIDES, type ToolPage } from '../site';
import { NOINDEX } from '../noindex.mjs';
interface Props { page: ToolPage }
const { page } = Astro.props;
const path = page.slug ? `/${page.slug}/` : '/';
const home = !page.slug;
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `${SITE.name}: ${page.h1}`,
    url: new URL(path, SITE.url).href,
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any (runs in the browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={page.title} description={page.description} path={path} jsonld={jsonld} noindex={NOINDEX.includes(page.slug)}>
  <Tool mode={page.mode} preset={page.preset} home={home} h1={page.h1} lede={page.lede} />
  <div class="adslot" aria-hidden="true"></div>
  {home && (
    <section class="block">
      <h2>Fix a common problem</h2>
      <p>Each guide starts from what you see on screen, then walks through the cause and the fix.</p>
      <ul class="plainlist">{GUIDES.map((g) => <li><a href={`/guides/${g.slug}/`}>{g.title}</a></li>)}</ul>
    </section>
  )}
  <section class="block">
    <h2>How it works</h2>
    <ol class="steps">{page.steps.map((s, i) => <li><span class="stepno" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span>{s}</span></li>)}</ol>
  </section>
  {page.example && (
    <section class="block">
      <h2>What changes in your file</h2>
      <p>{page.example.note}</p>
      <div class="samples">
        <div>
          <p class="sample-label">Before</p>
          <pre class="sample">{page.example.before}</pre>
        </div>
        <div>
          <p class="sample-label">After</p>
          <pre class="sample">{page.example.after}</pre>
        </div>
      </div>
    </section>
  )}
  <section class="block">
    <h2>Questions</h2>
    <div class="faq">{page.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
  </section>
  {page.guide && GUIDES.some((g) => g.slug === page.guide) && (
    <section class="block">
      <p class="guide-link">Read the guide: <a href={`/guides/${page.guide}/`}>{GUIDES.find((g) => g.slug === page.guide)!.title}</a></p>
    </section>
  )}
  {home && (
    <section class="block">
      <h2>Why it runs in your browser</h2>
      <p>Subtitle files are small text files, and every fix here is simple arithmetic on their timestamps or a change to their text. Your browser can do that in a fraction of a second, so there is no reason to send the file anywhere. That keeps unreleased or private material on your computer.</p>
    </section>
  )}
  {home && (
    <section class="block">
      <h2>Guides</h2>
      <ul class="plainlist">{GUIDES.map((g) => <li><a href={`/guides/${g.slug}/`}>{g.title}</a></li>)}</ul>
      <p class="guide-link"><a href="/guides/">See all guides</a></p>
    </section>
  )}
</Base>
