---
// avoid-ai-design-ignore-file: K7 (every :focus-visible rule lives in src/styles/site.css, loaded on every page by Base.astro)
import Base from '../layouts/Base.astro';
import Tool from './Tool.astro';
import { SITE, GUIDES, type ToolPage } from '../site';
interface Props { page: ToolPage }
const { page } = Astro.props;
const path = page.slug ? `/${page.slug}/` : '/';
const home = !page.slug;
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `${SITE.name}: ${page.h1}`,
    url: new URL(path, SITE.url).href,
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any (runs in the browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={page.title} description={page.description} path={path} jsonld={jsonld}>
  <Tool mode={page.mode} preset={page.preset} home={home} h1={page.h1} lede={page.lede} />
  <div class="adslot" aria-hidden="true"></div>
  <section class="block">
    <h2>How it works</h2>
    <ol class="steps">{page.steps.map((s, i) => <li><span class="stepno" aria-hidden="true">{i + 1}</span><span>{s}</span></li>)}</ol>
  </section>
  <section class="block">
    <h2>Questions</h2>
    <div class="faq">{page.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
  </section>
  {home && (
    <section class="block">
      <h2>Why it runs in your browser</h2>
      <p>Subtitle files are small text files, and every fix here is simple arithmetic on their timestamps or a change to their text. Your browser can do that in a fraction of a second, so there is no reason to send the file anywhere. That keeps unreleased or private material on your computer, and the tool keeps working if you lose your connection after the page loads.</p>
    </section>
  )}
  {home && (
    <section class="block">
      <h2>Guides</h2>
      <ul class="plainlist">{GUIDES.map((g) => <li><a href={`/guides/${g.slug}/`}>{g.title}</a></li>)}</ul>
    </section>
  )}
</Base>
