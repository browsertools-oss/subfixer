---
import { SITE, PAGES, GROUPS, GUIDES } from '../site';
interface Props {
  title: string;
  description: string;
  path: string;
  jsonld?: object[];
}
const { title, description, path, jsonld = [] } = Astro.props;
const canonical = new URL(path, SITE.url).href;
const others = GROUPS.map((g) => ({
  group: g,
  links: PAGES.filter((p) => p.group === g)
    .map((p) => ({ href: p.slug ? `/${p.slug}/` : '/', label: p.h1 }))
    .filter((t) => t.href !== path),
}));
const guides = GUIDES.map((g) => ({ href: `/guides/${g.slug}/`, label: g.title })).filter((t) => t.href !== path);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/atkinson-next-400.woff2" as="font" type="font/woff2" crossorigin />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to the tool</a>
    <header class="top">
      <a class="brand" href="/">SubFixer</a>
      <span class="tag">{SITE.tagline}</span>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      {others.map((o) => (
        <p class="others">
          {o.group}:{' '}
          {o.links.map((t, i) => <>{i > 0 && ', '}<a href={t.href}>{t.label}</a></>)}
        </p>
      ))}
      {guides.length > 0 && (
        <p class="others">Guides: {guides.map((t, i) => <>{i > 0 && ', '}<a href={t.href}>{t.label}</a></>)}</p>
      )}
      <p>
        Files never leave your device. <a href="/privacy/">Privacy</a> · <a href="/about/">About</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  /* Plain document style. One column, type and space, one dark primary button. See DESIGN.md. */
  @font-face { font-family: 'Atkinson Hyperlegible Next'; src: url('/fonts/atkinson-next-400.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Atkinson Hyperlegible Next'; src: url('/fonts/atkinson-next-600.woff2') format('woff2'); font-weight: 600; font-style: normal; font-display: swap; }
  :root {
    --bg: #ffffff;
    --tint: #f3f2ef;
    --ink: #1c1c1c;
    --soft: #5c5c5c;
    --rule: #e4e2dd;
    --field: #8f8d87;
    --btn: #1c1c1c;
    --btn-text: #ffffff;
    --btn-hover: #3a3a3a;
    --focus: #2f5bd3;
    --error: #c8102e;
    --mono: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141414;
      --tint: #1f1f1e;
      --ink: #ecebe8;
      --soft: #a8a6a1;
      --rule: #2e2d2b;
      --field: #6e6d68;
      --btn: #ecebe8;
      --btn-text: #141414;
      --btn-hover: #ffffff;
      --focus: #8aa8ff;
      --error: #ff6b7d;
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0; background: var(--bg); color: var(--ink);
    font: 17px/1.6 'Atkinson Hyperlegible Next', system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  a { color: inherit; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; text-decoration-color: var(--field); }
  a:hover { text-decoration-color: currentColor; }
  :focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; border-radius: 2px; }

  .skip { position: absolute; left: -9999px; top: 8px; background: var(--btn); color: var(--btn-text); padding: 8px 12px; z-index: 2; }
  .skip:focus { left: 8px; }

  .top, main, footer { max-width: 680px; margin: 0 auto; padding-left: 24px; padding-right: 24px; }
  .top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; padding-top: 28px; }
  .brand { font-weight: 600; text-decoration: none; font-size: 17px; }
  .tag { color: var(--soft); font-size: 15px; }
  main { padding-top: 72px; }

  h1 { font-size: 34px; line-height: 1.2; font-weight: 600; letter-spacing: -0.4px; margin: 0 0 12px; text-wrap: balance; }
  .lede { color: var(--soft); margin: 0 0 40px; max-width: 60ch; }
  main > p:not(.lede) { max-width: 60ch; }
  h2 { font-size: 20px; line-height: 1.3; font-weight: 600; margin: 0 0 12px; }
  main > h2 { margin-top: 40px; }

  .block { margin-top: 72px; }
  ol.steps { margin: 0; padding-left: 1.3em; }
  ol.steps li { padding-left: 4px; margin-bottom: 8px; }
  ol.steps li::marker { color: var(--soft); }
  .faq details { border-top: 1px solid var(--rule); }
  .faq details:last-child { border-bottom: 1px solid var(--rule); }
  .faq summary { cursor: pointer; padding: 14px 0; list-style-position: inside; }
  .faq summary::marker { color: var(--soft); }
  .faq details p { color: var(--soft); margin: 0 0 18px; max-width: 60ch; }

  footer { margin-top: 96px; padding-top: 24px; padding-bottom: 48px; color: var(--soft); font-size: 15px; }
  footer p { margin: 0 0 12px; }
  .others a { color: var(--ink); }

  /* tool */
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .drop { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; cursor: pointer; padding: 0; margin: 0; border-radius: 6px; }
  .drop[hidden] { display: none; }
  .drop.over { background: var(--tint); outline: 2px solid var(--ink); outline-offset: 16px; }
  .drop:focus-within { outline: 2px solid var(--focus); outline-offset: 16px; }
  .drop-main { font-size: 22px; font-weight: 600; line-height: 1.3; }
  .drop-sub { color: var(--soft); font-size: 15px; }
  .drop-btn, .primary {
    display: inline-flex; align-items: center; justify-content: center; height: 46px; padding: 0 22px;
    background: var(--btn); color: var(--btn-text); border: 0; border-radius: 6px;
    font: inherit; font-size: 16px; font-weight: 600; cursor: pointer;
  }
  .drop-btn { margin-top: 18px; }
  .drop:hover .drop-btn, .primary:hover { background: var(--btn-hover); }

  .loaded[hidden] { display: none; }
  .fileinfo { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; padding-bottom: 20px; border-bottom: 1px solid var(--rule); }
  .fileinfo strong { font-weight: 600; word-break: break-all; }
  #fmeta { color: var(--soft); font-size: 15px; flex: 1 1 100%; order: 2; font-variant-numeric: tabular-nums; }
  .enc { order: 3; display: flex; gap: 8px; align-items: center; color: var(--soft); font-size: 15px; }
  .enc select { height: 34px; }
  #reset { order: 1; }

  /* fix chooser: plain words, the chosen one is ink and underlined */
  .tabs { display: flex; flex-wrap: wrap; gap: 4px 24px; margin: 28px 0 28px; }
  .tabs button {
    background: none; border: 0; padding: 4px 0; font: inherit; font-size: 17px; color: var(--soft); cursor: pointer;
    text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 2px; text-underline-offset: 7px;
  }
  .tabs button:hover { color: var(--ink); }
  .tabs button[aria-selected='true'] { color: var(--ink); font-weight: 600; text-decoration-color: var(--ink); }

  .panel { display: flex; flex-wrap: wrap; gap: 16px 20px; align-items: flex-end; }
  .panel[hidden] { display: none; }
  .panel label, .outrow label { display: flex; flex-direction: column; gap: 6px; font-size: 15px; color: var(--soft); }
  .panel label.check { flex-direction: row; align-items: center; gap: 10px; color: var(--ink); width: 100%; font-size: 16px; }
  input[type='checkbox'] { width: 18px; height: 18px; margin: 0; accent-color: var(--ink); }
  .hint { width: 100%; color: var(--soft); font-size: 15px; margin: 0; }
  .syncrow { display: flex; flex-wrap: wrap; gap: 16px 20px; width: 100%; }
  .syncrow select { max-width: min(420px, 80vw); }
  input:not([type]), input[type='text'], select {
    font: inherit; font-size: 16px; color: var(--ink); background-color: var(--bg);
    border: 1px solid var(--field); border-radius: 6px; height: 44px; padding: 0 12px; min-width: 0;
  }
  input:not([type]), input[type='text'] { font-family: var(--mono); font-size: 15px; }
  input::placeholder { color: var(--soft); }
  select {
    -webkit-appearance: none; appearance: none; padding-right: 36px; cursor: pointer;
    background-image: linear-gradient(45deg, transparent 50%, var(--soft) 50%), linear-gradient(135deg, var(--soft) 50%, transparent 50%);
    background-position: right 17px center, right 12px center; background-size: 5px 5px, 5px 5px; background-repeat: no-repeat;
  }
  input:focus-visible, select:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
  .nudges { display: flex; gap: 8px; flex-wrap: wrap; }
  .nudges button, .swap {
    font: inherit; font-family: var(--mono); font-size: 14px; height: 44px; padding: 0 12px; cursor: pointer;
    background: var(--bg); color: var(--ink); border: 1px solid var(--field); border-radius: 6px;
  }
  .nudges button:hover, .swap:hover { border-color: var(--ink); }
  .swap { width: 44px; padding: 0; font-family: inherit; }
  .link { font: inherit; font-size: 15px; background: none; border: 0; padding: 0; color: var(--ink); cursor: pointer; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; text-decoration-color: var(--field); }
  .link:hover { text-decoration-color: currentColor; }

  .outrow { display: flex; flex-wrap: wrap; gap: 16px 20px; align-items: flex-end; margin-top: 36px; }
  .error { color: var(--ink); font-size: 15px; margin: 20px 0 0; border: 1px solid var(--error); border-radius: 6px; padding: 10px 14px; }
  .error[hidden] { display: none; }
  .preview { margin-top: 44px; overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: 15px; }
  th { text-align: left; font-weight: 400; color: var(--soft); padding: 0 16px 8px 0; white-space: nowrap; border-bottom: 1px solid var(--rule); }
  td { border-bottom: 1px solid var(--rule); padding: 8px 16px 8px 0; vertical-align: top; }
  .preview td:nth-child(-n+3) { font-family: var(--mono); font-size: 14px; white-space: nowrap; }
  .preview td:nth-child(1), .preview td:nth-child(2) { color: var(--soft); }
  .which td:first-child { width: 55%; }

  /* symptom picker: a plain radio list split by hairlines */
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  legend { padding: 0; }
  .pick { margin: 0 0 48px; }
  .pick[hidden] { display: none; }
  .pick legend { font-size: 20px; line-height: 1.3; font-weight: 600; margin-bottom: 10px; }
  .sym { display: flex; align-items: flex-start; gap: 12px; padding: 11px 0; border-top: 1px solid var(--rule); cursor: pointer; }
  .sym:last-of-type { border-bottom: 1px solid var(--rule); }
  .sym input, .cand input { margin-top: 4px; flex: none; }
  input[type='radio'] { width: 18px; height: 18px; accent-color: var(--ink); }
  .sym:has(input:checked) { font-weight: 600; }

  .filepick { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; color: var(--soft); font-size: 15px; }
  .filepick[hidden] { display: none; }
  .filepick select { height: 36px; max-width: min(420px, 80vw); color: var(--ink); }
  .note { color: var(--soft); font-size: 15px; margin: 14px 0 0; }
  .note[hidden], .batchnote[hidden] { display: none; }
  .batchnote { margin: 14px 0 0; }

  .panel.stack { display: block; }
  .panel.stack[hidden] { display: none; }
  .panel.stack > * + * { margin-top: 14px; }
  .panel label.wide { flex: 1 1 100%; }
  .panel label.wide select { max-width: 100%; }
  .panel.stack > label:not(.check) select { max-width: 100%; }

  /* fix characters: each reading of the file as a radio row with a sample */
  .cands { margin-top: 28px; }
  .cands legend { color: var(--soft); font-size: 15px; margin-bottom: 8px; }
  .cand { display: grid; grid-template-columns: 18px 1fr; column-gap: 12px; padding: 12px 0; border-top: 1px solid var(--rule); cursor: pointer; }
  .cand:last-child { border-bottom: 1px solid var(--rule); }
  .cand input { grid-row: span 2; }
  .cand-name { font-size: 15px; font-weight: 600; }
  .cand-lang { color: var(--soft); font-weight: 400; margin-left: 10px; }
  .cand-sample { grid-column: 2; overflow-wrap: anywhere; }
  .cand-sample em { color: var(--soft); }

  /* check and edit */
  .checks ul { margin: 0; padding-left: 1.2em; }
  .checks li { margin-bottom: 4px; }
  .checks-head { font-weight: 600; margin: 0 0 6px; }
  .editor { margin-top: 20px; border-bottom: 1px solid var(--rule); }
  .erow { display: grid; grid-template-columns: 2.5rem 8.75rem 8.75rem 1fr; gap: 8px 10px; padding: 14px 0; border-top: 1px solid var(--rule); align-items: center; }
  .enum { color: var(--soft); font-family: var(--mono); font-size: 14px; }
  .erow input.etime { height: 40px; width: 100%; padding: 0 8px; font-size: 14px; }
  .erow input[aria-invalid='true'] { border-color: var(--error); }
  .eact { justify-self: end; display: flex; gap: 16px; }
  textarea {
    grid-column: 2 / -1; width: 100%; font: inherit; font-size: 16px; line-height: 1.45; color: var(--ink); background: var(--bg);
    border: 1px solid var(--field); border-radius: 6px; padding: 8px 10px; resize: vertical;
  }
  textarea:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
  .eissue { grid-column: 2 / -1; margin: 0; color: var(--error); font-size: 14px; }
  .eissue:empty { display: none; }
  .edit-actions { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 14px; }
  .edit-actions [hidden] { display: none; }
  .primary:disabled { opacity: 0.6; cursor: progress; }

  .plainlist { margin: 0; padding-left: 1.2em; }
  .plainlist.spaced li { margin-bottom: 10px; }
  .guide h2 { margin-top: 44px; }
  .guide p, .guide li { max-width: 62ch; }
  .guide ol { padding-left: 1.3em; }
  code { font-family: var(--mono); font-size: 0.88em; }
  @media (max-width: 479px) {
    .top, main, footer { padding-left: 16px; padding-right: 16px; }
    .top { padding-top: 20px; }
    main { padding-top: 48px; }
    h1 { font-size: 28px; }
    .block { margin-top: 56px; }
    th, td { padding-right: 10px; }
    .primary { width: 100%; }
    .outrow label { flex: 1 1 100%; }
    .outrow select { width: 100%; }
    .erow { grid-template-columns: 2rem 1fr 1fr; }
    .eact { grid-column: 2 / -1; justify-self: start; }
    .which td:first-child { width: auto; }
  }
</style>
