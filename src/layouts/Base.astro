---
import { SITE, PAGES, GROUPS, GUIDES } from '../site';
interface Props {
  title: string;
  description: string;
  path: string;
  jsonld?: object[];
}
const { title, description, path, jsonld = [] } = Astro.props;
const canonical = new URL(path, SITE.url).href;
const ROLL: Record<string, string> = { Timing: 'timing', Text: 'text', Convert: 'convert' };
const others = GROUPS.map((g) => ({
  group: g,
  links: PAGES.filter((p) => p.group === g)
    .map((p) => ({ href: p.slug ? `/${p.slug}/` : '/', label: p.h1 }))
    .filter((t) => t.href !== path),
}));
const guides = GUIDES.map((g) => ({ href: `/guides/${g.slug}/`, label: g.title })).filter((t) => t.href !== path);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#e4e5e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121015" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/atkinson-next-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/atkinson-next-800.woff2" as="font" type="font/woff2" crossorigin />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
    <meta name="google-adsense-account" content="ca-pub-3033001375409079" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3033001375409079" crossorigin="anonymous"></script>
    <!-- Umami (cookie-free analytics): page views plus two events, a file added and a download, with the file type only. Never file names or contents. -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id="b1124074-6131-4fe6-b306-cd7260c0ef67" data-domains="subfixer.app"></script>
    <script is:inline>
      (() => {
        const ext = (n) => ((/\.([a-z0-9]{1,8})$/i.exec(n || '') || [])[1] || 'none').toLowerCase();
        const track = (name, data) => { try { window.umami && window.umami.track(name, data); } catch {} };
        const added = (files) => { if (files && files.length) track('file-added', { ext: ext(files[0].name), count: files.length }); };
        document.addEventListener('change', (e) => { const t = e.target; if (t instanceof HTMLInputElement && t.type === 'file') added(t.files); }, true);
        document.addEventListener('drop', (e) => added(e.dataTransfer && e.dataTransfer.files), true);
        document.addEventListener('click', (e) => { const a = e.target; if (a instanceof HTMLAnchorElement && a.hasAttribute('download')) track('download', { ext: ext(a.download) }); }, true);
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to the tool</a>
    <header class="top">
      <a class="brand" href="/"><span class="brand-tk" aria-hidden="true"></span>SubFixer</a>
      <span class="tag">{SITE.tagline}</span>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="foot-in">
        <div class="foot-rolls">
          {others.map((o) => (
            <div class="foot-roll" data-group={ROLL[o.group]}>
              <p class="foot-name">{o.group}</p>
              <ul>{o.links.map((t) => <li><a href={t.href}>{t.label}</a></li>)}</ul>
            </div>
          ))}
          {guides.length > 0 && (
            <div class="foot-roll">
              <p class="foot-name">Guides</p>
              <ul>{guides.map((t) => <li><a href={t.href}>{t.label}</a></li>)}</ul>
            </div>
          )}
        </div>
        <p class="foot-line">
          Files never leave your device. <a href="/privacy/">Privacy</a> · <a href="/about/">About</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Box office. Saturated roll tickets on a dark auditorium or a pale counter. See DESIGN.md. */
  @font-face { font-family: 'Atkinson Hyperlegible Next'; src: url('/fonts/atkinson-next-400.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Atkinson Hyperlegible Next'; src: url('/fonts/atkinson-next-600.woff2') format('woff2'); font-weight: 600; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Atkinson Hyperlegible Next'; src: url('/fonts/atkinson-next-800.woff2') format('woff2'); font-weight: 800; font-style: normal; font-display: swap; }
  :root {
    /* ground and surfaces */
    --bg: #e4e5e8;
    --raise: #f3f3f5;
    --sunk: #d6d8dd;
    --ink: #17151b;
    --soft: #4f4d57;
    --rule: #c3c5cc;
    --field: #7d7b86;
    /* the drop ticket is printed on the opposite stock */
    --stock: #17151b;
    --stock-ink: #f3f3f5;
    --stock-soft: #b9b7c2;
    /* roll ticket paper, the same in both modes: paper is printed with --print */
    --timing: #f2683a;
    --text: #3db56d;
    --convert: #5a8ef0;
    --print: #17110e;
    /* the screen */
    --screen: #0b0a0e;
    --screen-line: #2a2731;
    --sub: #ffe14d;
    --btn: #17151b;
    --btn-text: #f3f3f5;
    --btn-hover: #34313b;
    --focus: #2f5bd3;
    --error: #c8102e;
    --mono: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace;
    --r: 10px;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #121015;
      --raise: #1c1a21;
      --sunk: #0c0b0e;
      --ink: #efedf3;
      --soft: #aaa6b5;
      --rule: #2e2b35;
      --field: #6c6878;
      --stock: #efedf3;
      --stock-ink: #17151b;
      --stock-soft: #4f4d57;
      --screen: #070609;
      --btn: #efedf3;
      --btn-text: #121015;
      --btn-hover: #ffffff;
      --focus: #8aa8ff;
      --error: #ff6b7d;
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0; background: var(--bg); color: var(--ink);
    font: 17px/1.6 'Atkinson Hyperlegible Next', system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  ::selection { background: var(--sub); color: #17151b; }
  a { color: inherit; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; text-decoration-color: var(--field); }
  a:hover { text-decoration-color: currentColor; }
  :focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; border-radius: 4px; }

  .skip { position: absolute; left: -9999px; top: 8px; background: var(--btn); color: var(--btn-text); padding: 8px 12px; z-index: 2; }
  .skip:focus { left: 8px; }

  .top, main, .foot-in { max-width: 1180px; margin: 0 auto; padding-left: 32px; padding-right: 32px; }
  .top { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 16px; padding-top: 22px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; text-decoration: none; font-size: 19px; letter-spacing: -0.2px; }
  .brand-tk {
    width: 30px; height: 20px; border-radius: 3px; background: var(--timing);
    -webkit-mask: radial-gradient(circle 4px at 0 50%, #0000 98%, #000) left / 51% 100% no-repeat, radial-gradient(circle 4px at 100% 50%, #0000 98%, #000) right / 51% 100% no-repeat;
    mask: radial-gradient(circle 4px at 0 50%, #0000 98%, #000) left / 51% 100% no-repeat, radial-gradient(circle 4px at 100% 50%, #0000 98%, #000) right / 51% 100% no-repeat;
  }
  .tag { color: var(--soft); font-size: 15px; }
  main { padding-top: 40px; }

  h1 { font-size: clamp(36px, 4.6vw, 58px); line-height: 1.04; font-weight: 800; letter-spacing: -1.2px; margin: 0 0 16px; text-wrap: balance; }
  .lede { color: var(--soft); font-size: 19px; margin: 0 0 28px; max-width: 46ch; }
  main > p:not(.lede) { max-width: 62ch; }
  h2 { font-size: 26px; line-height: 1.2; font-weight: 800; letter-spacing: -0.4px; margin: 0 0 20px; }
  main > h2 { margin-top: 40px; }

  /* ---------- hero: copy and drop ticket on the left, the screen on the right ---------- */
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr); gap: 56px; align-items: center; }
  .tool.has-file .hero { grid-template-columns: 1fr; }
  .tool.has-file .screen, .tool.has-file .drop, .tool.has-file .trust { display: none; }
  .tool.has-file h1 { font-size: clamp(30px, 3.4vw, 40px); }
  .tool.has-file .lede { display: none; }
  .tool.has-file .viewer { margin-top: 28px; }

  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  /* a ticket outline: notches cut where the stub meets the body */
  .drop, .tk {
    --notch: 9px;
    -webkit-mask: radial-gradient(circle var(--notch) at var(--cut) 0, #0000 97%, #000) top / 100% 51% no-repeat, radial-gradient(circle var(--notch) at var(--cut) 100%, #0000 97%, #000) bottom / 100% 51% no-repeat;
    mask: radial-gradient(circle var(--notch) at var(--cut) 0, #0000 97%, #000) top / 100% 51% no-repeat, radial-gradient(circle var(--notch) at var(--cut) 100%, #0000 97%, #000) bottom / 100% 51% no-repeat;
  }
  .drop {
    --cut: 58px;
    display: grid; grid-template-columns: 58px 1fr; cursor: pointer; margin: 0;
    background: var(--stock); color: var(--stock-ink); border-radius: 14px; min-height: 230px;
    transition: transform 160ms cubic-bezier(.2,.7,.2,1);
  }
  .drop:hover { transform: translateY(-2px); }
  .drop.over { outline: 4px solid var(--sub); outline-offset: 0; transform: rotate(-0.6deg) scale(1.01); }
  .drop:focus-within { outline: 3px solid var(--focus); outline-offset: 4px; }
  .drop-stub, .tk-stub {
    display: grid; place-items: center; position: relative;
    background-image: radial-gradient(circle, var(--dot) 1.6px, transparent 2px);
    background-size: 4px 10px; background-repeat: repeat-y; background-position: right center;
  }
  .drop-stub { --dot: var(--bg); }
  .drop-stub span, .tk-stub span {
    writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap;
    font-size: 11px; font-weight: 800; letter-spacing: 2.4px; text-transform: uppercase;
  }
  .drop-stub span { color: var(--stock-soft); }
  .drop-body { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; padding: 30px 30px 26px 26px; }
  .drop-main { font-size: clamp(24px, 2.4vw, 30px); font-weight: 800; line-height: 1.15; letter-spacing: -0.4px; }
  .drop-sub { color: var(--stock-soft); font-size: 16px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .chip {
    font-family: var(--mono); font-size: 12px; font-weight: 600; letter-spacing: 0.6px; line-height: 1;
    padding: 6px 8px; border-radius: 4px; border: 1px solid var(--stock-soft); color: var(--stock-ink);
  }
  .drop-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin-top: 14px; }
  .drop-btn, .primary {
    display: inline-flex; align-items: center; justify-content: center; height: 50px; padding: 0 26px;
    border: 0; border-radius: 8px; font: inherit; font-size: 17px; font-weight: 800; cursor: pointer;
    transition: transform 120ms ease-out, background-color 120ms ease-out;
  }
  .drop-btn { background: var(--sub); color: #17151b; }
  .drop:hover .drop-btn { background: #fff06b; }
  .primary { background: var(--btn); color: var(--btn-text); }
  .primary:hover { background: var(--btn-hover); }
  .primary:active, .drop:active .drop-btn { transform: translateY(1px); }
  .drop-fix { font-size: 15px; font-weight: 600; color: var(--stock-ink); }
  .drop-fix:empty { display: none; }

  .trust { display: flex; flex-wrap: wrap; gap: 6px 22px; list-style: none; margin: 18px 0 0; padding: 0; font-size: 15px; font-weight: 600; }
  .trust li { display: inline-flex; align-items: center; gap: 8px; }
  .trust li::before { content: ''; width: 10px; height: 10px; border-radius: 2px; background: var(--timing); }
  .trust li:nth-child(2)::before { background: var(--text); }
  .trust li:nth-child(3)::before { background: var(--convert); }

  /* the screen: a still with a subtitle, and the cue lane sliding into sync with the speech */
  .screen { margin: 0; background: var(--screen); border-radius: 16px; padding: 14px 14px 12px; color: #d9d6e2; }
  .frame { display: block; width: 100%; aspect-ratio: 16 / 7.5; border-radius: 8px; }
  .frame .sky { fill: #1b1830; }
  .frame .moon { fill: #f4ecc8; opacity: .9; }
  .frame .city { fill: #0d0c15; }
  .frame .lit rect { fill: #e9c75a; opacity: .75; }
  .frame .line { fill: var(--sub); font: 600 23px 'Atkinson Hyperlegible Next', system-ui, sans-serif; paint-order: stroke; stroke: #000; stroke-width: 4px; stroke-linejoin: round; }
  .lanes { display: block; width: 100%; height: auto; margin-top: 12px; overflow: visible; }
  .lanes .lab { fill: #8e8a9b; font: 600 12px 'Atkinson Hyperlegible Next', system-ui, sans-serif; letter-spacing: 1px; text-transform: uppercase; }
  .lanes .track { stroke: var(--screen-line); stroke-width: 1; }
  .lanes .ghost { fill: none; stroke: #8e8a9b; stroke-width: 1.5; stroke-dasharray: 5 4; }
  .lanes .cue { fill: var(--timing); }
  .lanes .cuetext { fill: var(--print); font: 800 13px 'Atkinson Hyperlegible Next', system-ui, sans-serif; }
  .lanes .speech { stroke: #8e8a9b; stroke-width: 3; stroke-linecap: round; }
  .lanes .head { stroke: var(--sub); stroke-width: 2; }
  .screen figcaption { font-size: 13px; color: #8e8a9b; margin-top: 8px; }
  .snap { animation: snap 4.2s cubic-bezier(.7,0,.2,1) infinite; }
  @keyframes snap {
    0%, 22% { transform: translateX(80px); }
    46%, 88% { transform: translateX(0); }
    100% { transform: translateX(80px); }
  }

  /* ---------- the ticket rolls: one ticket per symptom, grouped by roll color ---------- */
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  legend { padding: 0; }
  .pick { margin: 72px 0 0; }
  .pick[hidden], .enc[hidden] { display: none; }
  .pick legend { font-size: 26px; line-height: 1.2; font-weight: 800; letter-spacing: -0.4px; margin-bottom: 22px; }
  .pick-q { display: block; }
  #loaded, #pick { scroll-margin-top: 20px; }
  .pick-how { display: block; margin-top: 6px; font-size: 16px; font-weight: 400; letter-spacing: 0; color: var(--soft); }
  .rolls { display: grid; gap: 26px; }
  .roll { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 16px; align-items: start; }
  .roll-name { margin: 12px 0 0; font-size: 13px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; display: flex; align-items: center; gap: 8px; }
  .roll-name::before { content: ''; width: 12px; height: 12px; border-radius: 50%; background: var(--paper); }
  .roll[data-group='timing'], .tk[data-group='timing'], [data-group='timing'] { --paper: var(--timing); }
  .roll[data-group='text'], .tk[data-group='text'], [data-group='text'] { --paper: var(--text); }
  .roll[data-group='convert'], .tk[data-group='convert'], [data-group='convert'] { --paper: var(--convert); }
  .tickets { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 14px; }
  .tk {
    --cut: 40px; --notch: 7px; --dot: var(--bg);
    display: grid; grid-template-columns: 40px 1fr; position: relative; cursor: pointer;
    background: var(--paper); color: var(--print); border-radius: 10px; min-height: 150px;
    border: 0; padding: 0; margin: 0; width: 100%; font: inherit; text-align: left; appearance: none;
    transition: transform 180ms cubic-bezier(.2,.7,.2,1);
  }
  .tk:hover { transform: translateY(-3px) rotate(-0.4deg); }
  .tk-stub span { color: var(--print); opacity: .78; font-size: 10px; letter-spacing: 2px; }
  .tk-paper { display: flex; flex-direction: column; gap: 10px; padding: 14px 16px 16px 12px; }
  .tk-art { width: 100%; height: auto; display: block; }
  .tk-art .cu { fill: var(--print); }
  .tk-art .ov { opacity: .62; }
  .tk-art .gh { fill: none; stroke: var(--print); stroke-width: 1.3; stroke-dasharray: 4 3; opacity: .7; }
  .tk-art .wv { stroke: var(--print); stroke-width: 2; stroke-linecap: round; opacity: .45; }
  .tk-art .cut { stroke: var(--print); stroke-width: 1.4; stroke-dasharray: 2 3; }
  .tk-art .strike { stroke: var(--print); stroke-width: 2.4; }
  .tk-art .arrow { stroke: var(--print); stroke-width: 2.2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .tk-art text { fill: var(--print); font: 700 13px var(--mono); }
  .tk-art text.inv { fill: var(--paper); }
  .tk-art text.keep { font-weight: 800; }
  .tk-art text.warn { font: 700 11px var(--mono); }
  .tk-art .tx { stroke: var(--print); stroke-width: 3; stroke-linecap: round; opacity: .8; }
  .tk-art .tx.inv { stroke: var(--paper); opacity: 1; }
  .tk-text { font-size: 16px; font-weight: 600; line-height: 1.35; }
  .tk:focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; }
  .tk:active { transform: translateY(-1px) scale(.99); }
  .tk.over { box-shadow: 0 0 0 4px var(--sub); transform: translateY(-4px) rotate(-0.6deg); }

  /* ---------- loaded: file bar, viewer, fix tabs, the counter ---------- */
  .loaded { margin-top: 28px; }
  .loaded[hidden] { display: none; }
  .fileinfo { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 18px; padding: 14px 18px; background: var(--raise); border-radius: var(--r); }
  .fileinfo strong { font-weight: 800; word-break: break-all; }
  #fmeta { color: var(--soft); font-size: 15px; flex: 1 1 100%; order: 2; font-variant-numeric: tabular-nums; }
  .enc { order: 3; display: flex; gap: 8px; align-items: center; color: var(--soft); font-size: 15px; }
  .enc select { height: 36px; }
  #reset { order: 1; }

  .viewer { margin-top: 16px; background: var(--screen); border-radius: 14px; padding: 12px; color: #d9d6e2; }
  .vscreen { height: 150px; border-radius: 8px; background: #1b1830; display: flex; align-items: flex-end; justify-content: center; padding: 0 20px 18px; }
  .vsub {
    margin: 0; text-align: center; white-space: pre-line; color: var(--sub); font-size: 21px; font-weight: 600; line-height: 1.3;
    text-shadow: 0 0 3px #000, 0 0 3px #000, 0 2px 2px #000; max-width: 34ch;
  }
  .vbar { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; margin: 10px 2px 8px; font-size: 13px; color: #a29eb0; font-variant-numeric: tabular-nums; }
  .vkey { display: inline-flex; align-items: center; gap: 6px; }
  .vkey i { display: inline-block; width: 14px; height: 8px; border-radius: 2px; }
  .vkey .k-before { background: #6c6878; }
  .vkey .k-after { background: var(--paper, var(--timing)); margin-left: 10px; }
  .cuemap { display: block; width: 100%; height: 60px; cursor: ew-resize; touch-action: none; border-radius: 4px; }
  .cuemap .cm-before { fill: #6c6878; }
  .cuemap .cm-after { fill: var(--paper, var(--timing)); }
  .cuemap .cm-issue { fill: #ff6b7d; }
  .cuemap .cm-head { stroke: var(--sub); stroke-width: 3; vector-effect: non-scaling-stroke; }
  .cuemap:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }

  .tabs { display: flex; flex-wrap: wrap; gap: 10px 28px; margin: 24px 0 0; }
  /* tabs sit in the same three rolls as the symptom tickets, so the jargon has a heading */
  .tabroll { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .tabroll-name { font-size: 12px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: var(--soft); display: flex; align-items: center; gap: 6px; margin-right: 2px; }
  .tabroll-name::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--paper); }
  .tabs button {
    font: inherit; font-size: 15px; font-weight: 600; height: 42px; padding: 0 16px; cursor: pointer;
    background: transparent; color: var(--ink); border: 2px solid var(--paper); border-radius: 8px;
    transition: background-color 120ms, transform 120ms;
  }
  .tabs button:hover { transform: translateY(-1px); }
  .tabs button[aria-selected='true'] { background: var(--paper); color: var(--print); font-weight: 800; }

  .counter { margin-top: 12px; background: var(--raise); border-radius: 14px; padding: 24px; }
  .panel { display: flex; flex-wrap: wrap; gap: 16px 20px; align-items: flex-end; }
  .panel[hidden] { display: none; }
  .panel label, .outrow label { display: flex; flex-direction: column; gap: 6px; font-size: 15px; color: var(--soft); }
  .panel label.check { flex-direction: row; align-items: center; gap: 10px; color: var(--ink); width: 100%; font-size: 16px; }
  input[type='checkbox'], input[type='radio'] { width: 18px; height: 18px; margin: 0; accent-color: var(--ink); }
  .hint { width: 100%; color: var(--soft); font-size: 15px; margin: 0; }
  .syncrow { display: flex; flex-wrap: wrap; gap: 16px 20px; width: 100%; }
  .syncrow select { max-width: min(420px, 80vw); }
  input:not([type]), input[type='text'], select {
    font: inherit; font-size: 16px; color: var(--ink); background-color: var(--bg);
    border: 1px solid var(--field); border-radius: 8px; height: 44px; padding: 0 12px; min-width: 0;
  }
  input:not([type]), input[type='text'] { font-family: var(--mono); font-size: 15px; }
  input::placeholder { color: var(--soft); }
  select {
    -webkit-appearance: none; appearance: none; padding-right: 36px; cursor: pointer;
