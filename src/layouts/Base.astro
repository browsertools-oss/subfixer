---
import { SITE, PAGES } from '../site';
interface Props {
  title: string;
  description: string;
  path: string;
  jsonld?: object[];
}
const { title, description, path, jsonld = [] } = Astro.props;
const canonical = new URL(path, SITE.url).href;
const nav = PAGES.filter((p) => p.slug);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#111318" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/"><span class="mark" aria-hidden="true">⟲</span>{SITE.name}</a>
      <span class="tag">{SITE.tagline}</span>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <nav aria-label="All tools">
        {nav.map((p) => <a href={`/${p.slug}/`}>{p.h1}</a>)}
      </nav>
      <p>
        Files never leave your device. <a href="/privacy/">Privacy</a> · <a href="/about/">About</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f7f6f2;
    --card: #ffffff;
    --ink: #17181c;
    --muted: #5d606b;
    --line: #e2e0d9;
    --accent: #2f5bd3;
    --accent-ink: #ffffff;
    --soft: #eef1fb;
    --bad: #b42318;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #111318;
      --card: #191c23;
      --ink: #eceef3;
      --muted: #9aa0ad;
      --line: #2b2f39;
      --accent: #7c9cff;
      --accent-ink: #0d1020;
      --soft: #1f2536;
      --bad: #ff8a80;
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 16px/1.55 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  a { color: var(--accent); }
  main, .top, footer { max-width: 860px; margin: 0 auto; padding: 0 16px; }
  .top { display: flex; align-items: baseline; gap: 12px; padding-top: 20px; flex-wrap: wrap; }
  .brand { font-weight: 700; font-size: 18px; color: var(--ink); text-decoration: none; letter-spacing: -0.01em; }
  .mark { color: var(--accent); margin-right: 6px; }
  .tag { color: var(--muted); font-size: 14px; }
  h1 { font-size: clamp(28px, 5vw, 40px); line-height: 1.1; letter-spacing: -0.02em; margin: 40px 0 12px; text-wrap: balance; }
  .lede { color: var(--muted); font-size: 18px; max-width: 64ch; margin: 0 0 28px; }
  h2 { font-size: 20px; margin: 48px 0 12px; letter-spacing: -0.01em; }
  ol.steps { padding-left: 20px; }
  ol.steps li { margin: 6px 0; }
  details { border-top: 1px solid var(--line); padding: 12px 0; }
  details:last-child { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; font-weight: 600; }
  details p { color: var(--muted); margin: 8px 0 0; }
  footer { margin-top: 64px; padding-bottom: 40px; color: var(--muted); font-size: 14px; border-top: 1px solid var(--line); }
  footer nav { display: flex; flex-wrap: wrap; gap: 6px 18px; padding: 20px 0 12px; }
  footer nav a { color: var(--muted); text-decoration: none; }
  footer nav a:hover { color: var(--ink); }

  /* tool */
  .tool { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 16px; }
  .drop { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; min-height: 200px; border: 2px dashed var(--line); border-radius: 10px; cursor: pointer; text-align: center; padding: 24px; transition: background .15s, border-color .15s; }
  .drop:hover, .drop.over { background: var(--soft); border-color: var(--accent); }
  .drop[hidden] { display: none; }
  .drop-main { font-size: 18px; font-weight: 600; }
  .drop-main u { color: var(--accent); text-underline-offset: 3px; }
  .drop-sub { color: var(--muted); font-size: 14px; }
  .fileinfo { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
  .fileinfo strong { word-break: break-all; }
  #fmeta { color: var(--muted); font-size: 14px; flex: 1 1 260px; }
  .enc { font-size: 14px; color: var(--muted); display: flex; gap: 6px; align-items: center; }
  .tabs { display: flex; gap: 4px; flex-wrap: wrap; margin: 14px 0; }
  .tabs button { border: 1px solid var(--line); background: transparent; color: var(--ink); padding: 8px 12px; border-radius: 999px; font: inherit; font-size: 14px; cursor: pointer; }
  .tabs button[aria-selected='true'] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .panel { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; }
  .panel[hidden] { display: none; }
  .panel label { display: flex; flex-direction: column; gap: 4px; font-size: 14px; color: var(--muted); }
  .panel label.check { flex-direction: row; align-items: center; gap: 8px; color: var(--ink); width: 100%; }
  .hint { width: 100%; color: var(--muted); font-size: 14px; margin: 4px 0 0; }
  .syncrow { display: flex; flex-wrap: wrap; gap: 12px; width: 100%; }
  .syncrow select { max-width: min(420px, 80vw); }
  input:not([type]), input[type='text'], select { font: inherit; font-size: 15px; color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; min-width: 0; }
  input:focus-visible, select:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .nudges { display: flex; gap: 4px; }
  .nudges button, .swap, .link { font: inherit; font-size: 14px; background: transparent; color: var(--ink); border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; cursor: pointer; }
  .link { border: 0; color: var(--accent); padding: 0; text-decoration: underline; }
  .outrow { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; justify-content: space-between; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--line); }
  .outrow label { display: flex; flex-direction: column; gap: 4px; font-size: 14px; color: var(--muted); }
  .primary { font: inherit; font-weight: 600; background: var(--accent); color: var(--accent-ink); border: 0; border-radius: 10px; padding: 12px 18px; cursor: pointer; }
  .primary:active { transform: translateY(1px); }
  .error { color: var(--bad); font-size: 14px; }
  .preview { margin-top: 16px; overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: 14px; }
  th { text-align: left; color: var(--muted); font-weight: 500; border-bottom: 1px solid var(--line); padding: 6px 8px; }
  td { border-bottom: 1px solid var(--line); padding: 6px 8px; vertical-align: top; font-variant-numeric: tabular-nums; }
  td:nth-child(2) { color: var(--muted); }
  td:nth-child(2), td:nth-child(3) { white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
