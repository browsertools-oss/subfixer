---
import { SITE, PAGES } from '../site';
interface Props {
  title: string;
  description: string;
  path: string;
  jsonld?: object[];
}
const { title, description, path, jsonld = [] } = Astro.props;
const canonical = new URL(path, SITE.url).href;
const nav = PAGES.filter((p) => p.slug);
const tools = PAGES.map((p) => ({ href: p.slug ? `/${p.slug}/` : '/', label: p.slug ? p.h1 : 'All fixes' }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/geist-400.woff2" as="font" type="font/woff2" crossorigin />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to the tool</a>
    <header class="shell-header">
      <a class="brand" href="/">Sub<b>Fixer</b></a>
      <span class="tag">{SITE.tagline}</span>
    </header>
    <div class="shell">
      <nav class="sidenav" aria-label="Tools">
        <ul>
          {tools.map((t) => (
            <li><a href={t.href} aria-current={t.href === path ? 'page' : undefined}>{t.label}</a></li>
          ))}
        </ul>
      </nav>
      <div class="content">
        <main id="main">
          <slot />
        </main>
        <footer>
          <nav aria-label="All tools">
            {nav.map((p) => <a href={`/${p.slug}/`}>{p.h1}</a>)}
          </nav>
          <p>
            Files never leave your device. <a href="/privacy/">Privacy</a> · <a href="/about/">About</a>
          </p>
        </footer>
      </div>
    </div>
  </body>
</html>

<style is:global>
  /* Design system: Vercel's Geist language (light and dark). See DESIGN.md. */
  @font-face { font-family: 'Geist'; src: url('/fonts/geist-400.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Geist'; src: url('/fonts/geist-500.woff2') format('woff2'); font-weight: 500; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Geist'; src: url('/fonts/geist-600.woff2') format('woff2'); font-weight: 600; font-style: normal; font-display: swap; }
  :root {
    --canvas: #ffffff;
    --canvas-soft: #fafafa;
    --canvas-soft-2: #f5f5f5;
    --hover: #f2f2f2;
    --hairline: #ebebeb;
    --hairline-strong: #a1a1a1;
    --ink: #171717;
    --body: #4d4d4d;
    --mute: #666666;
    --on-primary: #ffffff;
    --primary: #171717;
    --primary-hover: #383838;
    --link: #0761d1;
    --link-hover: #0070f3;
    --focus: #0070f3;
    --error: #ee0000;
    --error-soft: #fff0f0;
    --shadow: 0 1px 1px rgba(0, 0, 0, 0.02), 0 2px 2px rgba(0, 0, 0, 0.04);
    --shadow-raised: 0 1px 2px rgba(0, 0, 0, 0.08), 0 2px 4px rgba(0, 0, 0, 0.04);
    --mono: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --canvas: #0a0a0a;
      --canvas-soft: #000000;
      --canvas-soft-2: #1a1a1a;
      --hover: #1f1f1f;
      --hairline: #2e2e2e;
      --hairline-strong: #707070;
      --ink: #ededed;
      --body: #a1a1a1;
      --mute: #a1a1a1;
      --on-primary: #0a0a0a;
      --primary: #ededed;
      --primary-hover: #cccccc;
      --link: #52a8ff;
      --link-hover: #8cc4ff;
      --focus: #52a8ff;
      --error: #ff6166;
      --error-soft: #2a1314;
      --shadow: 0 0 0 1px rgba(255, 255, 255, 0.02);
      --shadow-raised: 0 1px 2px rgba(0, 0, 0, 0.6);
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--canvas-soft);
    color: var(--ink);
    font: 16px/24px 'Geist', system-ui, -apple-system, 'Segoe UI', sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  ::selection { background: var(--ink); color: var(--canvas); }
  a { color: var(--link); text-underline-offset: 3px; text-decoration-thickness: 1px; }
  a:hover { color: var(--link-hover); }
  :focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-radius: 6px; }

  .skip { position: absolute; left: -9999px; top: 8px; background: var(--primary); color: var(--on-primary); padding: 8px 12px; border-radius: 6px; z-index: 2; font-size: 14px; }
  .skip:focus { left: 8px; }

  /* top bar: canvas with a hairline, 64px */
  .shell-header {
    height: 64px; display: flex; align-items: center; gap: 12px;
    background: var(--canvas); border-bottom: 1px solid var(--hairline); padding: 0 24px;
  }
  .brand { color: var(--ink); text-decoration: none; font-size: 18px; font-weight: 600; letter-spacing: -0.54px; }
  .brand b { font-weight: 600; }
  .brand:hover { color: var(--ink); }
  .shell-header .tag { color: var(--mute); font-size: 14px; line-height: 20px; letter-spacing: -0.28px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-left: 12px; border-left: 1px solid var(--hairline); }

  .sidenav { display: none; }
  .content { min-width: 0; }
  main, footer > * { max-width: 768px; }
  main { padding: 40px 24px 0; }

  @media (min-width: 1056px) {
    .shell { display: grid; grid-template-columns: 248px minmax(0, 1fr); }
    .sidenav {
      display: block; position: sticky; top: 0; align-self: start;
      height: 100vh; height: 100dvh; overflow-y: auto;
      border-right: 1px solid var(--hairline); padding: 24px 12px;
    }
    .sidenav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
    .sidenav a {
      display: block; padding: 6px 12px; border-radius: 6px;
      color: var(--body); text-decoration: none; font-size: 14px; line-height: 20px; letter-spacing: -0.28px;
    }
    .sidenav a:hover { background: var(--hover); color: var(--ink); }
    .sidenav a[aria-current='page'] { background: var(--canvas-soft-2); color: var(--ink); font-weight: 500; }
    main { padding: 48px 48px 0; }
  }

  h1 { font-size: 24px; line-height: 32px; font-weight: 600; letter-spacing: -0.96px; margin: 0 0 8px; text-wrap: balance; }
  @media (min-width: 672px) { h1 { font-size: 32px; line-height: 40px; letter-spacing: -1.28px; } }
  .lede { color: var(--body); font-size: 16px; line-height: 24px; max-width: 64ch; margin: 0 0 32px; }
  main > p:not(.lede) { max-width: 64ch; color: var(--body); }
  h2 { font-size: 20px; line-height: 28px; font-weight: 600; letter-spacing: -0.6px; margin: 0 0 16px; }
  main > h2 { margin-top: 40px; }

  /* reference sections below the tool: stacked, heading on top */
  .block { padding: 40px 0 0; }
  .tool + .block { margin-top: 24px; }
  ol.steps { list-style: none; counter-reset: s; margin: 0; padding: 0; display: grid; gap: 12px; }
  ol.steps li { counter-increment: s; display: grid; grid-template-columns: 24px 1fr; gap: 12px; color: var(--body); }
  ol.steps li::before {
    content: counter(s); display: grid; place-items: center; width: 24px; height: 24px; border-radius: 9999px;
    background: var(--canvas); border: 1px solid var(--hairline); color: var(--ink);
    font-family: var(--mono); font-size: 12px; line-height: 1;
  }
  .faq { background: var(--canvas); border: 1px solid var(--hairline); border-radius: 12px; box-shadow: var(--shadow); overflow: hidden; }
  .faq details + details { border-top: 1px solid var(--hairline); }
  .faq summary {
    cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 12px 20px; min-height: 52px; font-weight: 500; font-size: 15px; letter-spacing: -0.2px;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: ''; flex: none; width: 7px; height: 7px; margin-right: 2px;
    border-right: 1.5px solid var(--mute); border-bottom: 1.5px solid var(--mute); transform: rotate(45deg) translate(-2px, -2px);
  }
  .faq details[open] summary::after { transform: rotate(-135deg) translate(-2px, -2px); }
  .faq summary:hover { background: var(--canvas-soft); }
  .faq summary:focus-visible { outline-offset: -2px; border-radius: 0; }
  .faq details p { color: var(--body); margin: 0; padding: 0 48px 16px 20px; max-width: 68ch; font-size: 14px; line-height: 22px; }

  footer { margin-top: 64px; padding: 32px 24px 40px; border-top: 1px solid var(--hairline); color: var(--mute); font-size: 14px; line-height: 20px; letter-spacing: -0.28px; }
  footer nav { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 4px 32px; padding-bottom: 24px; }
  footer nav a { color: var(--body); text-decoration: none; padding: 4px 0; }
  footer nav a:hover { color: var(--ink); }
  footer p { margin: 0; }
  footer p a { color: var(--body); }
  footer p a:hover { color: var(--ink); }
  @media (min-width: 1056px) { footer { padding: 32px 48px 40px; } }
  @media (max-width: 479px) {
    .shell-header { padding: 0 16px; height: 56px; }
    .shell-header .tag { display: none; }
    main { padding: 32px 16px 0; }
    footer { padding: 32px 16px 40px; }
  }

  /* tool */
  .tool { margin-top: 0; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .drop {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; text-align: center;
    min-height: 240px; padding: 40px 24px; cursor: pointer;
    background: var(--canvas); border: 1px dashed var(--hairline-strong); border-radius: 12px;
  }
  .drop:hover { background: var(--canvas-soft); border-color: var(--ink); }
  .drop.over { border: 1px solid var(--focus); background: var(--canvas-soft); box-shadow: 0 0 0 3px color-mix(in srgb, var(--focus) 20%, transparent); }
  .drop:focus-within { outline: 2px solid var(--focus); outline-offset: 2px; }
  .drop[hidden] { display: none; }
  .drop-main { font-size: 20px; line-height: 28px; font-weight: 600; letter-spacing: -0.6px; }
  .drop-sub { color: var(--body); font-size: 14px; line-height: 20px; letter-spacing: -0.28px; }
  .drop-btn {
    margin-top: 20px; display: inline-flex; align-items: center; height: 40px; padding: 0 16px; border-radius: 6px;
    background: var(--primary); color: var(--on-primary); font-size: 14px; font-weight: 500;
  }
  .drop:hover .drop-btn { background: var(--primary-hover); }
  @media (max-width: 479px) { .drop { padding: 32px 16px; min-height: 200px; } }

  .loaded { background: var(--canvas); border: 1px solid var(--hairline); border-radius: 12px; box-shadow: var(--shadow); padding: 0 24px 24px; }
  .loaded[hidden] { display: none; }
  .fileinfo {
    display: flex; flex-wrap: wrap; gap: 4px 16px; align-items: center;
    margin: 0 -24px; padding: 14px 24px; border-bottom: 1px solid var(--hairline);
  }
  .fileinfo strong { word-break: break-all; font-weight: 500; font-size: 14px; font-family: var(--mono); }
  #fmeta { color: var(--mute); font-size: 14px; letter-spacing: -0.28px; flex: 1 1 260px; font-variant-numeric: tabular-nums; }
  .enc { font-size: 13px; color: var(--mute); display: flex; gap: 8px; align-items: center; }
  .enc select { height: 32px; }

  /* tabs: segmented control */
  .tabs {
    display: flex; gap: 2px; margin: 20px 0 24px; padding: 3px; overflow-x: auto; scrollbar-width: none;
    background: var(--canvas-soft-2); border-radius: 8px; width: fit-content; max-width: 100%;
  }
  .tabs::-webkit-scrollbar { display: none; }
  .tabs button {
    flex: none; height: 32px; padding: 0 12px; border: 0; border-radius: 6px;
    background: transparent; color: var(--body); font: inherit; font-size: 14px; font-weight: 500; letter-spacing: -0.28px; cursor: pointer; white-space: nowrap;
  }
  .tabs button:hover { color: var(--ink); }
  .tabs button[aria-selected='true'] { background: var(--canvas); color: var(--ink); box-shadow: var(--shadow-raised), 0 0 0 1px var(--hairline); }
  .tabs button:focus-visible { outline-offset: -2px; }

  .panel { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-end; }
  .panel[hidden] { display: none; }
  .panel label, .outrow label { display: flex; flex-direction: column; gap: 6px; font-size: 13px; line-height: 16px; font-weight: 500; color: var(--body); }
  .panel label.check { flex-direction: row; align-items: center; gap: 10px; color: var(--ink); width: 100%; font-size: 14px; line-height: 20px; font-weight: 400; letter-spacing: -0.28px; }
  input[type='checkbox'] { width: 16px; height: 16px; margin: 0; accent-color: var(--primary); }
  .hint { width: 100%; color: var(--mute); font-size: 14px; line-height: 20px; letter-spacing: -0.28px; margin: 0; }
  .syncrow { display: flex; flex-wrap: wrap; gap: 16px; width: 100%; }
  .syncrow select { max-width: min(420px, 80vw); }
  input:not([type]), input[type='text'], select {
    font: inherit; font-size: 14px; letter-spacing: -0.28px; color: var(--ink);
    background-color: var(--canvas); border: 1px solid var(--hairline); border-radius: 6px;
    height: 40px; padding: 0 12px; min-width: 0;
    transition: border-color 0.15s ease;
  }
  input:not([type]), input[type='text'] { font-family: var(--mono); font-size: 14px; letter-spacing: 0; }
  input:not([type]):hover, input[type='text']:hover, select:hover { border-color: var(--hairline-strong); }
  input::placeholder { color: var(--mute); }
  select {
    -webkit-appearance: none; appearance: none; padding-right: 36px; cursor: pointer;
    background-image: linear-gradient(45deg, transparent 50%, var(--mute) 50%), linear-gradient(135deg, var(--mute) 50%, transparent 50%);
    background-position: right 17px center, right 12px center;
    background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat;
  }
  input:focus-visible, select:focus-visible { outline: none; border-color: var(--focus); box-shadow: 0 0 0 3px color-mix(in srgb, var(--focus) 25%, transparent); }
  button:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .nudges { display: flex; border: 1px solid var(--hairline); border-radius: 6px; overflow: hidden; }
  .nudges button, .swap {
    font: inherit; font-family: var(--mono); font-size: 13px; height: 38px; padding: 0 12px; cursor: pointer;
    background: var(--canvas); color: var(--ink); border: 0; border-radius: 0;
  }
  .nudges button + button { border-left: 1px solid var(--hairline); }
  .nudges button:focus-visible { outline-offset: -2px; border-radius: 0; }
  .nudges button:hover, .swap:hover { background: var(--hover); }
  .swap { width: 40px; height: 40px; padding: 0; font-family: inherit; border: 1px solid var(--hairline); border-radius: 6px; }
  .link { font: inherit; font-size: 14px; letter-spacing: -0.28px; background: none; border: 0; color: var(--link); padding: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .link:hover { color: var(--link-hover); }

  .outrow {
    display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-end; justify-content: space-between;
    margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--hairline);
  }
  .primary {
    font: inherit; font-size: 14px; font-weight: 500;
    background: var(--primary); color: var(--on-primary); border: 0; border-radius: 6px;
    height: 40px; padding: 0 20px; cursor: pointer; transition: background-color 0.15s ease;
  }
  .primary:hover { background: var(--primary-hover); }
  .primary:active { transform: translateY(1px); }
  .error {
    color: var(--ink); font-size: 14px; line-height: 20px; letter-spacing: -0.28px; margin: 16px 0 0;
    background: var(--error-soft); border: 1px solid var(--error); border-radius: 6px; padding: 10px 14px;
  }
  .error[hidden] { display: none; }
  .preview { margin-top: 24px; overflow-x: auto; border: 1px solid var(--hairline); border-radius: 8px; }
  table { border-collapse: collapse; width: 100%; font-size: 14px; letter-spacing: -0.28px; }
  th { text-align: left; font-family: var(--mono); font-size: 12px; font-weight: 400; letter-spacing: 0; color: var(--mute); background: var(--canvas-soft); padding: 0 12px; height: 32px; white-space: nowrap; border-bottom: 1px solid var(--hairline); }
  td { border-bottom: 1px solid var(--hairline); padding: 8px 12px; vertical-align: top; line-height: 20px; }
  tbody tr:last-child td { border-bottom: 0; }
  tbody tr:hover td { background: var(--canvas-soft); }
  td:nth-child(-n+3) { font-family: var(--mono); font-size: 13px; letter-spacing: 0; white-space: nowrap; }
  td:nth-child(1), td:nth-child(2) { color: var(--mute); }
  @media (max-width: 479px) {
    .loaded { padding: 0 16px 16px; }
    .fileinfo { margin: 0 -16px; padding: 12px 16px; }
    th, td { padding-left: 8px; padding-right: 8px; }
    .primary { width: 100%; }
    .outrow label { flex: 1; }
  }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
