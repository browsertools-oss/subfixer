---
// avoid-ai-design-ignore-file: K7 (every :focus-visible rule lives in src/styles/site.css, loaded on every page by Base.astro)
import { SITE, PAGES, GROUPS, GUIDES } from '../site';
import '../styles/site.css';
interface Props {
  title: string;
  description: string;
  path: string;
  jsonld?: object[];
}
const { title, description, path, jsonld = [] } = Astro.props;
const canonical = new URL(path, SITE.url).href;
const ROLL: Record<string, string> = { Timing: 'timing', Text: 'text', Convert: 'convert' };
const others = GROUPS.map((g) => ({
  group: g,
  links: PAGES.filter((p) => p.group === g)
    .map((p) => ({ href: p.slug ? `/${p.slug}/` : '/', label: p.h1 }))
    .filter((t) => t.href !== path),
}));
const guides = GUIDES.map((g) => ({ href: `/guides/${g.slug}/`, label: g.title })).filter((t) => t.href !== path);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#e6dfcf" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1916" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/archivo-narrow-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/six-caps-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/bevan-400.woff2" as="font" type="font/woff2" crossorigin />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to the tool</a>
    <header class="top">
      <a class="brand" href="/">SubFixer</a>
      <span class="tag">{SITE.tagline}</span>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="foot-in">
        <div class="foot-rolls">
          {others.map((o) => (
            <div class="foot-roll" data-group={ROLL[o.group]}>
              <p class="foot-name">{o.group}</p>
              <ul>{o.links.map((t) => <li><a href={t.href}>{t.label}</a></li>)}</ul>
            </div>
          ))}
          {guides.length > 0 && (
            <div class="foot-roll">
              <p class="foot-name">Guides</p>
              <ul>{guides.map((t) => <li><a href={t.href}>{t.label}</a></li>)}</ul>
            </div>
          )}
        </div>
        <p class="foot-line">
          <span>Files never leave your device.</span> <a href="/privacy/">Privacy</a> <a href="/about/">About</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* the Floor, repeated where the document is built: no sideways scroll at any width */
  html, body { overflow-x: clip; }
</style>
