---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site';
---
<Base title={`About | ${SITE.name}`} description="A free, private subtitle fixer that runs in your browser." path="/about/">
  <h1>About {SITE.name}</h1>
  <p class="lede">A small tool for the subtitle problems people run into most: wrong timing, frame-rate drift, garbled characters and the wrong format.</p>
  <p>It runs on your own device, so files are processed right away, private files never get uploaded, and it keeps working offline once loaded. It uses open-source libraries, including subsrt-ts and jschardet.</p>
</Base>
