---
import Base from '../../layouts/Base.astro';
import { GUIDES } from '../../site';

// Groups on this page, in order. Each guide's `topic` in src/site.ts must be one of these keys.
const TOPICS = [
  { key: 'players', title: 'Plex, Jellyfin, Kodi and VLC' },
  { key: 'devices', title: 'TVs, Chromecast and the web' },
  { key: 'editing', title: 'Editing, uploading and extracting' },
  { key: 'file', title: 'Fixing the file' },
];
const SUMMARIES: Record<string, string> = {
  'remove-tags-from-subtitles': 'Why subtitle files show curly-brace codes like \\an8, font colour tags or italic tags, and how to remove them with the subtitle cleaner.',
  'subtitles-showing-twice': 'Why every subtitle line shows twice: two tracks turned on, or a file that repeats its own lines. How to tell them apart and remove the repeats.',
  'kodi-subtitles-out-of-sync': 'Kodi\'s subtitle delay stays in the player, not the file. How to find the size of the gap and fix the subtitle file once, so it plays right every time.',
  'subtitles-out-of-sync-partway': 'Subtitles that are right at first and then jump: why a cut video needs a shift from one line onward, and how to find that line.',
  'tv-subtitles-not-showing-usb': 'Why a Samsung, LG or Sony TV skips subtitles on a USB stick: the file name, the hidden .txt extension, the ANSI encoding LG asks for, and picture subtitles.',
  'subtitles-out-of-sync': 'Subtitles early, late or drifting further off as the video plays: how to tell which of the three problems you have and which fix to use for each.',
  'srt-vtt-ass': 'What SRT, VTT and ASS each say about a line of dialogue, and which players and websites accept them.',
  'sup-to-srt-guide': 'How to pull a .sup picture subtitle track off a Blu-ray and turn it into a text SRT file, free in your browser.',
  'plex-subtitles-out-of-sync': 'Why Plex\'s subtitle offset is not enough, and how to fix the .srt file itself so every device on the server plays in sync.',
  'subtitles-weird-characters': 'Why accents turn into Ã© and letters into boxes, how to match the symptom to the encoding, and how to save as UTF-8.',
  '23976-vs-25-fps-subtitles': 'Why subtitles drift further out as the video plays: the 25 vs 23.976 fps numbers, how to check your frame rate, and the exact fix.',
  'vlc-subtitle-delay': 'What VLC\'s delay keys are for, why the player never fixes the file, and how to write the correction into the .srt once and for all.',
  'dual-language-subtitles': 'Watch in two languages at once for learning: merge the files, put one language at the top, and join CD1 and CD2 into one file.',
  'burned-in-vs-soft-subtitles': 'How to tell burned-in subtitles from a track you can turn off, and why only soft tracks can be fixed or saved.',
  'mx-player-subtitle-sync': 'Fix MX Player subtitles that are early or late in the file itself, so they play right on any device.',
  'mp4-subtitles-not-showing-on-tv': 'Save the subtitle track from an MP4 as an SRT with the same name as the video, so the TV can load it.',
  'join-cd1-cd2-subtitles': 'Two subtitle files for a split movie? Merge them into one file with the right timing. The parts mode auto-computes the offset.',
  'put-subtitles-inside-mkv': 'Put the SRT inside the MKV as a track, with no re-encoding, so the TV and Plex can read it.',
  'mkv-wrong-default-subtitles': 'Change which subtitle track an MKV turns on by default, or remove the ones you never use, without re-encoding.',
  'subtitles-overlapping-lines': 'What overlapping and zero-length subtitle lines are, how the validator finds them, and how the timing fixer repairs them.',
  'remove-sdh-from-subtitles': 'Remove sound notes like [door slams] and speaker names from a subtitle file, with a before and after.',
  'extract-subtitles-from-mkv-without-software': 'Forced, SDH, default or PGS? What each MKV subtitle track holds, which one to save, and how to turn PGS into SRT in your browser.',
};
---
<Base title="Subtitle guides | SubFixer" description="Guides to common subtitle problems: out-of-sync lines, Plex timing, garbled characters, frame-rate drift, two languages at once, and Blu-ray SUP files." path="/guides/">
  <h1>Subtitle guides</h1>
  <p class="lede">Plain answers to the subtitle problems people search for, each with the free tools that fix the problem.</p>
  {TOPICS.map((t) => (
    <>
      <h2>{t.title}</h2>
      <ul class="plainlist spaced">
        {GUIDES.filter((g) => g.topic === t.key).map((g) => (
          <li>
            <a href={`/guides/${g.slug}/`}>{g.title}</a>.{SUMMARIES[g.slug] && <> {SUMMARIES[g.slug]}</>}
          </li>
        ))}
      </ul>
    </>
  ))}
</Base>
