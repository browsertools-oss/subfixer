---
import Base from '../../layouts/Base.astro';
import { GUIDES } from '../../site';
const SUMMARIES: Record<string, string> = {
  'extract-subtitles-from-mkv-without-software': 'How to tell a subtitle track from burned-in text, save a text track from an MKV in your browser, and name the file so Plex and Jellyfin find it.',
  'subtitles-out-of-sync-partway': 'Subtitles that are right at first and then jump: why a cut video needs a shift from one line onward, and how to find that line.',
  'tv-subtitles-not-showing-usb':'Why a Samsung, LG or Sony TV skips subtitles on a USB stick: the file name, the hidden .txt extension, the ANSI encoding LG asks for, and picture subtitles.',
  'subtitles-out-of-sync': 'Subtitles early, late or drifting further off as the video plays: how to tell which of the three problems you have and which fix to use for each.',
  'srt-vtt-ass': 'What SRT, VTT and ASS each say about a line of dialogue, and which players and websites accept them.',
  'sup-to-srt-guide': 'How to pull a .sup picture subtitle track off a Blu-ray and turn it into a text SRT file, free in your browser.',
  'plex-subtitles-out-of-sync': 'Why Plex\'s subtitle offset is not enough, and how to fix the .srt file itself so every device on the server plays in sync.',
  'subtitles-weird-characters': 'Why accents turn into Ã© and letters into boxes, how to match the symptom to the encoding, and how to save as UTF-8.',
  '23976-vs-25-fps-subtitles': 'Why subtitles drift further out as the video plays: the 25 vs 23.976 fps numbers, how to check your frame rate, and the exact fix.',
  'vlc-subtitle-delay': 'What VLC\'s delay keys are for, why the player never fixes the file, and how to write the correction into the .srt once and for all.',
  'dual-language-subtitles': 'Watch in two languages at once for learning: merge the files, put one language at the top, and join CD1 and CD2 into one file.',
};
---
<Base title="Subtitle guides | SubFixer" description="Guides to common subtitle problems: out-of-sync lines, Plex timing, garbled characters, frame-rate drift, two languages at once, and Blu-ray SUP files." path="/guides/">
  <h1>Subtitle guides</h1>
  <p class="lede">Plain answers to the subtitle problems people search for, each with the free tools that fix the problem.</p>
  <ul class="plainlist spaced">
    {GUIDES.map((g) => (
      <li>
        <a href={`/guides/${g.slug}/`}>{g.title}</a>.{SUMMARIES[g.slug] && <> {SUMMARIES[g.slug]}</>}
      </li>
    ))}
  </ul>
</Base>
