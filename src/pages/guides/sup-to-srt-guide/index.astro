---
import Base from '../../../layouts/Base.astro';
const title = "PGS subtitles won't show? Convert them to SRT";
const jsonld = [{ '@context': 'https://schema.org', '@type': 'Article', headline: title, datePublished: '2026-11-16', author: { '@type': 'Organization', name: 'SubFixer' } }];
