---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site';
---
<Base title={`Privacy | ${SITE.name}`} description="How SubFixer handles your files and data." path="/privacy/">
  <h1>Privacy</h1>
  <p class="lede">Your subtitle files are processed entirely in your browser. They are never uploaded, stored or seen by us.</p>
  <h2>What we collect</h2>
  <p>We use privacy-friendly, cookie-free analytics to count page views and which tools are used. No personal data, no tracking across sites.</p>
  <h2>Advertising</h2>
  <p>If ads are shown, the ad provider may use cookies to serve and measure them, as described in its own policy. Where required, you will be asked for consent first.</p>
  <h2>Contact</h2>
  <p>Questions: <a href="mailto:hello@subfixer.example">hello@subfixer.example</a></p>
</Base>
